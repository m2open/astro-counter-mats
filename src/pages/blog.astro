---
import Layout from '../components/Layout.astro';
---

<Layout title="Blog - Custom Counter Mats">
    <section style="padding: 120px 20px 60px; text-align: center; background: linear-gradient(135deg, #1e40af, #3b82f6);">
        <h1 style="font-size: 3.2rem; margin-bottom: 20px;">Our Blog</h1>
        <p style="font-size: 1.3rem; max-width: 700px; margin: 0 auto;">
            Insights, tips, and stories about custom counter mats, bar branding, and the hospitality industry.
        </p>
    </section>

    <section style="padding: 80px 20px; max-width: 1200px; margin: 0 auto;">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 40px;">

            <article style="background: #1e2937; border-radius: 16px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.3);">
                <img src="/images/blog1.jpg" alt="Bar Mat Trends" style="width:100%; height:500px; object-fit: cover;">
                <div style="padding: 25px;">
                    <h3 style="margin: 0 0 12px 0;">Top 5 Trends in Custom Bar Mats for 2026</h3>
                    <p style="opacity: 0.8; line-height: 1.6;">
                        Discover the latest designs, materials, and branding strategies that top restaurants and bars are using right now.
                    </p>
                    <a href="#" style="color: #f97316; text-decoration: none; font-weight: 600; margin-top: 20px; display: inline-block;">
                        Read More →
                    </a>
                </div>
            </article>

            <article style="background: #1e2937; border-radius: 16px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.3);">
                <img src="/images/blog2.jpg" alt="Why Custom Mats Matter" style="width:100%; height:500px; object-fit: cover;">
                <div style="padding: 25px;">
                    <h3 style="margin: 0 0 12px 0;">Why Every Restaurant Needs Custom Counter Mats</h3>
                    <p style="opacity: 0.8; line-height: 1.6;">
                        From spill protection to brand visibility — here's how custom mats can boost your business.
                    </p>
                    <a href="#" style="color: #f97316; text-decoration: none; font-weight: 600; margin-top: 20px; display: inline-block;">
                        Read More →
                    </a>
                </div>
            </article>

            <article style="background: #1e2937; border-radius: 16px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.3);">
                <img src="/images/blog3.jpg" alt="Material Guide" style="width:100%; height:500px; object-fit: cover;">
                <div style="padding: 25px;">
                    <h3 style="margin: 0 0 12px 0;">Rubber vs Fabric: Choosing the Right Mat Material</h3>
                    <p style="opacity: 0.8; line-height: 1.6;">
                        A complete guide to help you choose the best material for your specific needs.
                    </p>
                    <a href="#" style="color: #f97316; text-decoration: none; font-weight: 600; margin-top: 20px; display: inline-block;">
                        Read More →
                    </a>
                </div>
            </article>

        </div>
    </section>
</Layout>