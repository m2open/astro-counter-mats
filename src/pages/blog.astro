---
import Layout from '../components/Layout.astro';
import { craftQuery } from '../lib/craft';

const data = await craftQuery('{ entries(section: "blog") { id title slug ... on blog_default_Entry { summary featuredImage { url alt } } } }');
const posts = data.entries as any[];
---

<Layout title="Blog - Custom Counter Mats">
    <section style="padding: 120px 20px 60px; text-align: center; background: linear-gradient(135deg, #1e40af, #3b82f6);">
        <h1 style="font-size: 3.2rem; margin-bottom: 20px;">Our Blog</h1>
        <p style="font-size: 1.3rem; max-width: 700px; margin: 0 auto;">
            Insights, tips, and stories about custom counter mats, bar branding, and the hospitality industry.
        </p>
    </section>

    <section style="padding: 80px 20px; max-width: 1200px; margin: 0 auto;">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 40px;">
            {posts.map((post) => (
                <article style="background: #1e2937; border-radius: 16px; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.3);">
                    {post.featuredImage[0] && (
                        <img src={post.featuredImage[0].url} alt={post.featuredImage[0].alt || post.title} style="width:100%; height:250px; object-fit: cover;" />
                    )}
                    <div style="padding: 25px;">
                        <h3 style="margin: 0 0 12px 0;">{post.title}</h3>
                        <p style="opacity: 0.8; line-height: 1.6;">{post.summary}</p>
                        <a href={`/blog/${post.slug}`} style="color: #f97316; text-decoration: none; font-weight: 600; margin-top: 20px; display: inline-block;">
                            Read More →
                        </a>
                    </div>
                </article>
            ))}
        </div>
    </section>
</Layout>