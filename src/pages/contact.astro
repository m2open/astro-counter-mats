---
import Header from '../components/Header.astro';
---

<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Contact Us - Custom Counter Mats</title>
</head>
<body>
    <Header currentPage="contact" />
    
    <main style="padding: 4rem 2rem; max-width: 800px; margin: 0 auto; text-align: center;">
        <h1>Contact Us</h1>
        <p style="font-size: 1.3rem; margin: 2rem 0;">
            Ready to discuss your custom counter mat project?<br>
            Send us your requirements and we'll get back to you within 24 hours.
        </p>
        
        <div style="margin: 3rem 0;">
            <p><strong>Email:</strong> your-email@example.com</p>
            <p><strong>WhatsApp / WeChat:</strong> +[Your Number]</p>
            <p><strong>X:</strong> <a href="https://x.com/yourusername" target="_blank">@yourusername</a></p>
        </div>
        
        <a href="mailto:your-email@example.com" style="background:#f97316; color:white; padding:16px 40px; border-radius:50px; text-decoration:none; font-weight:bold; display:inline-block;">
            Send Email Now
        </a>
    </main>
</body>
</html>