---
import Layout from '../components/Layout.astro';
---

<Layout title="Request a Quote - Custom Counter Mats">

<section style="padding:140px 20px 100px;text-align:center;background:linear-gradient(135deg,#4F46E5,#2563EB);">
    <h1 style="font-size:3.2rem;margin-bottom:20px;">
        Request a Quote
    </h1>

    <p style="font-size:1.35rem;max-width:750px;margin:0 auto;">
        Tell us about your custom counter mat project.<br>
        Our OEM team will review your requirements and reply within 24 hours.
    </p>
</section>


<section style="padding:80px 20px;background:#F8FAFC;">

<div style="max-width:900px;margin:auto;">

<div style="background:white;padding:50px;border-radius:20px;box-shadow:0 10px 30px rgba(0,0,0,.08);">


<h2 style="margin-bottom:35px;text-align:center;">
Get Your Custom Quote
</h2>


<form>

<label>Product Type</label>
<select>
<option>Hard Surface Counter Mat</option>
<option>Fabric Counter Mat</option>
<option>Changeable Insert Counter Mat</option>
<option>Premium Bar Counter Mat</option>
<option>Eco-Friendly Counter Mat</option>
<option>Custom Shape Counter Mat</option>
<option>Duraframe Window Poster Frame</option>
</select>


<label>Quantity</label>
<select>
<option>100 pcs</option>
<option>500 pcs</option>
<option>1000 pcs</option>
<option>5000+ pcs</option>
</select>


<label>Size / Dimension</label>
<input type="text" placeholder="Example: 600mm x 300mm">


<label>Logo Method</label>
<select>
<option>Full Color Printing</option>
<option>Screen Printing</option>
<option>Embossed Logo</option>
<option>Custom Requirement</option>
</select>


<label>Your Company</label>
<input type="text">


<label>Email</label>
<input type="email">


<label>WhatsApp</label>
<input type="text">


<label>Project Details</label>
<textarea rows="5"></textarea>


<button type="submit">
Submit Quote Request →
</button>

</form>


</div>

</div>

</section>


<section style="padding:60px 20px;text-align:center;">

<h2>Direct Contact</h2>

<p>
Email:
<a href="mailto:countermat25@gmail.com">
countermat25@gmail.com
</a>
</p>

<p>
WhatsApp:
+8613168787818
</p>

</section>


</Layout>