---
import Layout from '../components/Layout.astro';
---

<Layout title="Request a Quote - Custom Counter Mats">

  <!-- Hero -->
  <section class="contact-hero">
    <div class="container hero-content">
      <span class="eyebrow">OEM & Custom Manufacturing</span>

      <h1>Request a Quote</h1>

      <p>
        Tell us about your custom counter mat project.
        Our OEM team will review your requirements and reply within 24 hours.
      </p>
    </div>
  </section>

  <!-- Quote Form -->
  <section class="quote-section">
    <div class="container">
      <div class="quote-card">

        <div class="form-header">
          <span class="section-label">GET STARTED</span>
          <h2>Get Your Custom Quote</h2>
          <p>
            Please provide as much information as possible.
            This helps our team prepare an accurate quotation for your project.
          </p>
        </div>

        <form class="quote-form">

          <div class="form-grid">

            <div class="form-group full-width">
              <label for="product">Product Type</label>
              <select id="product" name="product">
                <option>Hard Surface Counter Mat</option>
                <option>Fabric Counter Mat</option>
                <option>Changeable Insert Counter Mat</option>
                <option>Premium Bar Counter Mat</option>
                <option>Eco-Friendly Counter Mat</option>
                <option>Custom Shape Counter Mat</option>
                <option>Duraframe Window Poster Frame</option>
              </select>
            </div>

            <div class="form-group">
              <label for="quantity">Quantity</label>
              <select id="quantity" name="quantity">
                <option>100 pcs</option>
                <option>250 pcs</option>
                <option>500 pcs</option>
                <option>750 pcs</option>
                <option>1,000 pcs</option>
                <option>1,500 pcs</option>
                <option>2,000 pcs</option>
                <option>2,500 pcs</option>
                <option>5,000+ pcs</option>
              </select>
            </div>

            <div class="form-group">
              <label for="size">Size / Dimension</label>
              <input id="size" name="size" type="text" placeholder="Example: A4, A3, A2 or Letter Size" />
            </div>

            <div class="form-group full-width">
              <label for="logo">Logo / Decoration Method</label>
              <select id="logo" name="logo">
                <option>Full Color Printing</option>
                <option>Screen Printing</option>
                <option>Embossed Logo</option>
                <option>Custom Requirement</option>
              </select>
            </div>

            <div class="form-group">
              <label for="company">Your Company</label>
              <input id="company" name="company" type="text" placeholder="Company name" />
            </div>

            <div class="form-group">
              <label for="email">Email <span>*</span></label>
              <input id="email" name="email" type="email" placeholder="you@company.com" required />
            </div>

            <div class="form-group">
              <label for="whatsapp">WhatsApp</label>
              <input id="whatsapp" name="whatsapp" type="tel" placeholder="+1 234 567 8900" />
            </div>

            <div class="form-group full-width">
              <label for="details">Project Details</label>
              <textarea
                id="details"
                name="details"
                rows="6"
                placeholder="Please tell us about your project, artwork, packaging, delivery destination, target price, or any special requirements."
              ></textarea>
            </div>

          </div>

          <div class="form-footer">
            <p class="required-note">
              <span>*</span> Required field
            </p>

            <button type="submit">
              Submit Quote Request
              <span aria-hidden="true">→</span>
            </button>
          </div>

        </form>
      </div>
    </div>
  </section>

  <!-- Direct Contact -->
  <section class="direct-contact">
    <div class="container">

      <div class="direct-header">
        <span class="section-label">CONTACT OUR TEAM</span>
        <h2>Prefer to Contact Us Directly?</h2>
        <p>
          You can also reach our OEM team by email or WhatsApp.
        </p>
      </div>

      <div class="contact-methods">

        <a class="contact-method" href="mailto:info@customcountermat.com">
          <div class="contact-icon">✉</div>
          <div>
            <span>Email</span>
            <strong>info@customcountermat.com</strong>
          </div>
        </a>

        <a
          class="contact-method"
          href="https://wa.me/8613168787818"
          target="_blank"
          rel="noopener noreferrer"
        >
          <div class="contact-icon">◉</div>
          <div>
            <span>WhatsApp</span>
            <strong>+86 131 6878 7818</strong>
          </div>
        </a>

      </div>
    </div>
  </section>

</Layout>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
  }

  .container {
    width: min(1100px, calc(100% - 40px));
    margin: 0 auto;
  }

  .contact-hero {
    padding: 150px 0 110px;
    background: linear-gradient(135deg, #4F46E5 0%, #2563EB 100%);
    color: #ffffff;
    text-align: center;
  }

  .hero-content {
    max-width: 850px;
  }

  .eyebrow {
    display: inline-block;
    margin-bottom: 18px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.9;
  }

  .contact-hero h1 {
    margin: 0 0 20px;
    font-size: clamp(2.5rem, 6vw, 3.75rem);
    line-height: 1.1;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .contact-hero p {
    max-width: 720px;
    margin: 0 auto;
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.7;
    opacity: 0.95;
  }

  .quote-section {
    padding: 90px 0;
    background: #F8FAFC;
  }

  .quote-card {
    max-width: 920px;
    margin: 0 auto;
    padding: 55px;
    background: #ffffff;
    border: 1px solid #E2E8F0;
    border-radius: 20px;
    box-shadow: 0 15px 45px rgba(15, 23, 42, 0.08);
  }

  .form-header {
    margin-bottom: 42px;
    text-align: center;
  }

  .section-label {
    display: inline-block;
    margin-bottom: 12px;
    color: #4F46E5;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .form-header h2,
  .direct-header h2 {
    margin: 0 0 14px;
    color: #111827;
    font-size: clamp(1.8rem, 4vw, 2.35rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .form-header p,
  .direct-header p {
    max-width: 680px;
    margin: 0 auto;
    color: #64748B;
    font-size: 1rem;
    line-height: 1.7;
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
  }

  .full-width {
    grid-column: 1 / -1;
  }

  .form-group label {
    margin-bottom: 9px;
    color: #1E293B;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .form-group label span,
  .required-note span {
    color: #4F46E5;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    border: 1px solid #CBD5E1;
    border-radius: 9px;
    background: #ffffff;
    color: #111827;
    font-family: inherit;
    font-size: 0.95rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .form-group input,
  .form-group select {
    min-height: 50px;
    padding: 0 14px;
  }

  .form-group textarea {
    min-height: 145px;
    padding: 14px;
    resize: vertical;
    line-height: 1.6;
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: #94A3B8;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: #4F46E5;
    box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.12);
  }

  .form-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 34px;
    padding-top: 28px;
    border-top: 1px solid #E2E8F0;
  }

  .required-note {
    margin: 0;
    color: #64748B;
    font-size: 0.85rem;
  }

  .form-footer button {
    min-height: 52px;
    padding: 0 26px;
    border: 0;
    border-radius: 9px;
    background: #4F46E5;
    color: #ffffff;
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .form-footer button:hover {
    background: #4338CA;
    transform: translateY(-1px);
    box-shadow: 0 8px 20px rgba(79, 70, 229, 0.2);
  }

  .form-footer button span {
    margin-left: 8px;
    font-size: 1.1rem;
  }

  .direct-contact {
    padding: 85px 0 95px;
    background: #ffffff;
  }

  .direct-header {
    margin-bottom: 40px;
    text-align: center;
  }

  .contact-methods {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    max-width: 850px;
    margin: 0 auto;
  }

  .contact-method {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 24px;
    border: 1px solid #E2E8F0;
    border-radius: 14px;
    background: #ffffff;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }

  .contact-method:hover {
    border-color: #A5B4FC;
    box-shadow: 0 10px 25px rgba(15, 23, 42, 0.07);
    transform: translateY(-2px);
  }

  .contact-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 48px;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: #EEF2FF;
    color: #4F46E5;
    font-size: 1.25rem;
    font-weight: 700;
  }

  .contact-method span {
    display: block;
    margin-bottom: 5px;
    color: #64748B;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .contact-method strong {
    display: block;
    color: #111827;
    font-size: 0.98rem;
    line-height: 1.4;
  }

  @media (max-width: 700px) {
    .container {
      width: min(100% - 30px, 1100px);
    }

    .contact-hero {
      padding: 120px 0 80px;
    }

    .quote-section {
      padding: 55px 0;
    }

    .quote-card {
      padding: 30px 20px;
      border-radius: 16px;
    }

    .form-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .full-width {
      grid-column: auto;
    }

    .form-footer {
      flex-direction: column;
      align-items: stretch;
    }

    .required-note {
      text-align: center;
    }

    .form-footer button {
      width: 100%;
    }

    .direct-contact {
      padding: 60px 0 70px;
    }

    .contact-methods {
      grid-template-columns: 1fr;
    }
  }
</style>
