---
import Layout from '../components/Layout.astro';
---

<Layout title="OEM Custom Counter Mats">
    <!-- Hero -->
    <section style="background: linear-gradient(135deg, #1e40af, #3b82f6); padding: 160px 20px; text-align: center;">
        <h1 style="font-size: 3.6rem; margin-bottom: 24px;">OEM Custom Counter Mats</h1>
        <p style="font-size: 1.4rem; max-width: 820px; margin: 0 auto 40px;">
            High-quality custom bar mats, counter mats, and promotional flooring solutions<br>
            manufactured for restaurants, bars, casinos, retail stores and global brands.
        </p>
        <a href="/contact" style="background:var(--accent); color:white; padding:18px 48px; border-radius:50px; text-decoration:none; font-weight:bold; font-size:1.2rem;">
            Request Quote
        </a>
    </section>

    <!-- Custom Counter Mats Show -->
    <section style="padding: 100px 20px; text-align: center; background: var(--gray);">
        <h2 style="font-size: 2.6rem; margin-bottom: 50px;">Custom Counter Mats Show</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 25px; max-width: 1200px; margin: 0 auto;">
            <img src="/images/mat1.jpg" alt="Custom Counter Mat" style="width:100%; border-radius:16px; box-shadow: 0 15px 35px rgba(0,0,0,0.4);">
            <img src="/images/mat2.jpg" alt="Custom Counter Mat" style="width:100%; border-radius:16px; box-shadow: 0 15px 35px rgba(0,0,0,0.4);">
            <img src="/images/mat3.jpg" alt="Custom Counter Mat" style="width:100%; border-radius:16px; box-shadow: 0 15px 35px rgba(0,0,0,0.4);">
        </div>
    </section>

    <!-- Why Global Clients Choose Us -->
    <section style="padding: 100px 20px; text-align: center;">
        <h2 style="font-size: 2.8rem; margin-bottom: 60px;">Why Global Clients Choose Us</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 40px; max-width: 1200px; margin: 0 auto;">
            <div style="background: var(--gray); padding: 40px; border-radius: 16px;">
                <h3>Custom Branding</h3>
                <p>Logo printing, full-color designs, custom shapes and sizes according to your specifications.</p>
            </div>
            <div style="background: var(--gray); padding: 40px; border-radius: 16px;">
                <h3>Premium Materials</h3>
                <p>Heavy-duty natural rubber base + high-absorbency fabric top. Built to last.</p>
            </div>
            <div style="background: var(--gray); padding: 40px; border-radius: 16px;">
                <h3>Reliable Global Export</h3>
                <p>Experienced in international shipping with consistent quality control.</p>
            </div>
            <div style="background: var(--gray); padding: 40px; border-radius: 16px;">
                <h3>Flexible MOQ</h3>
                <p>From small test orders to large volume production — we accommodate your needs.</p>
            </div>
        </div>
    </section>
</Layout>