---
import Layout from '../components/Layout.astro';
---

<Layout title="OEM Custom Counter Mats">
    <!-- Hero Section -->
    <section style="background: linear-gradient(135deg, #1e40af, #3b82f6); padding: 140px 20px; text-align: center;">
        <h1 style="font-size: 3.5rem; margin: 0 0 20px 0;">OEM Custom Counter Mats</h1>
        <p style="font-size: 1.4rem; max-width: 800px; margin: 0 auto 40px;">
            High-quality custom bar mats, counter mats, and promotional flooring solutions<br>
            manufactured for restaurants, bars, casinos, retail stores and global brands.
        </p>
        <a href="/contact" style="background:#f97316; color:white; padding:18px 48px; border-radius:50px; text-decoration:none; font-weight:bold; font-size:1.2rem;">
            Request Custom Quote
        </a>
    </section>

    <!-- Custom Counter Mats Show -->
    <section style="padding: 80px 20px; text-align: center; background: #1e2937;">
        <h2 style="font-size: 2.5rem; margin-bottom: 50px;">Custom Counter Mats Show</h2>
        
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 25px; max-width: 1200px; margin: 0 auto;">
            <div>
                <img src="/images/mat1.jpg" 
                     alt="Custom Bar Counter Mat" 
                     style="width:100%; border-radius:12px; box-shadow: 0 10px 30px rgba(0,0,0,0.4);">
                <p style="margin-top: 12px; font-weight: 500;">Premium Bar Counter Mat</p>
            </div>
            
            <div>
                <img src="/images/mat2.jpg" 
                     alt="Restaurant Checkout Mat" 
                     style="width:100%; border-radius:12px; box-shadow: 0 10px 30px rgba(0,0,0,0.4);">
                <p style="margin-top: 12px; font-weight: 500;">Restaurant Counter Mat</p>
            </div>
            
            <div>
                <img src="/images/mat3.jpg" 
                     alt="Branded Promotional Mat" 
                     style="width:100%; border-radius:12px; box-shadow: 0 10px 30px rgba(0,0,0,0.4);">
                <p style="margin-top: 12px; font-weight: 500;">Promotional Counter Mat</p>
            </div>
        </div>
    </section>

    <!-- Why Global Clients Choose Us -->
    <section style="padding: 100px 20px; text-align: center; background: #0f172a;">
        <h2 style="font-size: 2.8rem; margin-bottom: 60px;">Why Global Clients Choose Us</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 40px; max-width: 1200px; margin: 0 auto;">
            <div style="background: #1e2937; padding: 40px; border-radius: 16px;">
                <h3>Custom Branding</h3>
                <p>Logo printing, full-color designs, custom shapes and sizes according to your specifications.</p>
            </div>
            <div style="background: #1e2937; padding: 40px; border-radius: 16px;">
                <h3>Premium Materials</h3>
                <p>Heavy-duty natural rubber base + high-absorbency fabric top. Built to last.</p>
            </div>
            <div style="background: #1e2937; padding: 40px; border-radius: 16px;">
                <h3>Reliable Global Export</h3>
                <p>Experienced in international shipping with consistent quality control.</p>
            </div>
            <div style="background: #1e2937; padding: 40px; border-radius: 16px;">
                <h3>Flexible MOQ</h3>
                <p>From small test orders to large volume production — we accommodate your needs.</p>
            </div>
        </div>
    </section>
</Layout>