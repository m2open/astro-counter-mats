---
import Layout from '../components/Layout.astro';

// CustomCounterMat Home Page v3.9 — Hero image balance correction
// Premium Industrial Manufacturer Design

const productLines = [
  {
    name: "Hard Surface Counter Mats",
    desc: "Durable commercial surfaces designed for long-term branding applications.",
    slug: "hard-surface-counter-mats",
    image: "/images/products/hard-surface-counter-mat.webp",
    alt: "Custom hard surface counter mat manufactured for retail brands and commercial applications"
  },
  {
    name: "Fabric Counter Mats",
    desc: "Soft-touch promotional mats with high-quality custom printing.",
    slug: "fabric-counter-mats",
    image: "/images/products/fabric-counter-mat.webp",
    alt: "Custom fabric counter mat with printed branding for promotional and retail displays"
  },
  {
    name: "Changeable Insert Counter Mats",
    desc: "Flexible solutions for seasonal campaigns and replaceable graphics.",
    slug: "changeable-insert-counter-mats",
    image: "/images/products/changeable-insert-counter-mat.webp",
    alt: "Changeable insert counter mat with replaceable graphics for flexible brand promotions"
  },
  {
    name: "Premium Bar Counter Mats",
    desc: "Heavy-duty mats developed for hospitality, bars, and beverage brands.",
    slug: "premium-bar-counter-mats",
    image: "/images/products/premium-bar-counter-mat.webp",
    alt: "Premium custom bar counter mat designed for hospitality and beverage brands"
  },
  {
    name: "Eco-friendly Counter Mats",
    desc: "Sustainable material options for responsible brand promotion.",
    slug: "eco-friendly-counter-mats",
    image: "/images/products/eco-friendly-counter-mats.webp",
    alt: "Eco-friendly custom counter mat made with sustainable materials for brand promotion"
  },
  {
    name: "Custom Shapes & Sizes",
    desc: "Fully customized dimensions and specifications for unique projects.",
    slug: "custom-shapes-sizes",
    image: "/images/products/custom-shapes-sizes-counter-mat.webp",
    alt: "Custom shaped counter mat manufactured in unique sizes for brand displays"
  },
  {
    name: "Duraframe Window Poster Frame",
    desc: "Custom magnetic display frames for retail windows, offices and promotional signage applications.",
    slug: "duraframe-window-poster-frame",
    image: "/images/products/duraframe-window-poster-frame.webp",
    alt: "Custom Duraframe Window Poster Frame OEM Manufacturer for Retail Displays"
  }
];

const capabilities = [
  {
    title: "Manufacturing Expertise",
    desc: "Complete production knowledge from material selection to finished products."
  },
  {
    title: "Custom Engineering",
    desc: "Every project is developed around your specifications and market needs."
  },
  {
    title: "Quality Control",
    desc: "Consistent production standards for international business partners."
  },
  {
    title: "Export Support",
    desc: "Professional documentation and shipping coordination worldwide."
  }
];

const trustItems = [
  {
    number: "13+",
    title: "Years Manufacturing",
    desc: "Long-term experience producing custom counter mats and promotional products."
  },
  {
    number: "OEM",
    title: "Private Label",
    desc: "Custom materials, printing, packaging and product development support."
  },
  {
    number: "30+",
    title: "Export Markets",
    desc: "Supporting distributors, retailers and brands across international markets."
  },
  {
    number: "Custom",
    title: "Production",
    desc: "Flexible specifications for different sizes, materials, shapes and applications."
  },
  {
    number: "QC",
    title: "Quality Control",
    desc: "Production inspection standards designed for consistent international supply."
  }
];

const processSteps = [
  {
    number: "1",
    title: "Project Discussion",
    desc: "Understand your product requirements, quantity, target market and application."
  },
  {
    number: "2",
    title: "Artwork & Specification",
    desc: "Review dimensions, materials, printing, colors, packaging and technical requirements."
  },
  {
    number: "3",
    title: "Sample Approval",
    desc: "Produce samples for confirmation of appearance, materials, printing and specifications."
  },
  {
    number: "4",
    title: "Mass Production",
    desc: "Manufacture according to approved specifications with production and quality control."
  },
  {
    number: "5",
    title: "Global Delivery",
    desc: "Prepare export packaging and documentation and coordinate shipment to your destination."
  }
];

const industries = [
  {
    title: "Retail Brands",
    desc: "Custom counter mats for retail displays, promotions and branded point-of-sale environments.",
    image: "/images/industries/retail-brands.webp",
    alt: "Custom counter mat used for retail brand promotion"
  },
  {
    title: "Hospitality",
    desc: "Durable branded mats designed for hotels, restaurants, cafés and hospitality environments.",
    image: "/images/industries/hospitality.webp",
    alt: "Custom branded counter mat for hospitality applications"
  },
  {
    title: "Bars & Breweries",
    desc: "Custom promotional mats developed for bars, breweries, beverage brands and drink promotions.",
    image: "/images/industries/bars-breweries.webp",
    alt: "Custom bar counter mat for beverage brand promotion"
  },
  {
    title: "Food & Beverage",
    desc: "Branded counter mats supporting product launches, promotions and food and beverage campaigns.",
    image: "/images/industries/food-beverage.webp",
    alt: "Custom counter mat for food and beverage marketing"
  },
  {
    title: "Promotional Agencies",
    desc: "OEM production support for agencies managing customized promotional products for their clients.",
    image: "/images/industries/promotional-agencies.webp",
    alt: "Custom promotional counter mat manufactured for an agency"
  },
  {
    title: "Corporate Branding",
    desc: "Custom branded mats for corporate events, campaigns, offices and customer engagement programs.",
    image: "/images/industries/corporate-branding.webp",
    alt: "Custom branded counter mat for corporate marketing"
  }
];
---

<Layout
    title="Custom Counter Mats | OEM Manufacturer & Private Label Supplier"
    description="OEM manufacturer of custom counter mats for bars, retail, and promotional brands. Private-label production, custom sizes, and worldwide export support."
>

  <!-- Hero -->
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-content">
        <p class="eyebrow">OEM Counter Mat Manufacturer</p>

        <h1>
          Custom Counter Mats
          <span>Manufactured for Global Brands</span>
        </h1>

        <p class="hero-text">
          OEM and private label counter mat manufacturing with custom
          materials, printing, packaging and worldwide export support.
        </p>

        <div class="actions">
          <a href="/request-a-quote/" class="btn primary">Request a Quote</a>
          <a href="/products" class="btn secondary">View Products</a>
        </div>

        <div class="hero-points">
          <span>✓ Factory Direct</span>
          <span>✓ Custom Production</span>
          <span>✓ Global Export</span>
        </div>
      </div>

      <div class="hero-media">
        <img
          src="/images/home/hero-counter-mat.webp"
          alt="Custom counter mats manufactured for global brands"
          width="1920"
          height="900"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- Trust -->
  <section class="trust-bar" aria-label="Manufacturing capabilities">
    <div>
      <strong>13+</strong>
      <span>Years Manufacturing</span>
    </div>
    <div>
      <strong>OEM</strong>
      <span>Private Label</span>
    </div>
    <div>
      <strong>30+</strong>
      <span>Export Markets</span>
    </div>
    <div>
      <strong>QC</strong>
      <span>Quality Control</span>
    </div>
  </section>

  <!-- Products -->
  <section class="products">
    <div class="section-header">
      <p class="eyebrow">Product Solutions</p>
      <h2>Custom Counter Mat Product Lines</h2>
      <p>
        Professional OEM solutions designed for brands, distributors and
        promotional markets worldwide.
      </p>
    </div>

    <div class="product-grid">
      {productLines.map((product) => (
        <article class="product-card">
          <a href={`/products/${product.slug}/`} class="product-image-link">
            <img
              src={product.image}
              alt={product.alt}
              width="1200"
              height="900"
              loading="lazy"
              decoding="async"
            />
          </a>

          <div class="product-card-content">
            <h3>{product.name}</h3>
            <p>{product.desc}</p>
            <a href={`/products/${product.slug}/`} class="card-link">
              Explore Product <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="capabilities">
    <div class="section-header">
      <p class="eyebrow">Why Partner With Us</p>
      <h2>Built for Long-Term OEM Partnerships</h2>
      <p>
        We combine manufacturing experience, customization capability and
        export expertise to support global companies.
      </p>
    </div>

    <div class="capability-grid">
      {capabilities.map((item, index) => (
        <article class="capability-card">
          <div class="capability-number">0{index + 1}</div>
          <h3>{item.title}</h3>
          <p>{item.desc}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- Factory -->
  <section class="factory">
    <div class="section-header">
      <p class="eyebrow">Our Factory</p>
      <h2>Trusted OEM Manufacturing Capability</h2>
      <p>
        With 13+ years of manufacturing experience, we support global brands,
        distributors and promotional companies with reliable OEM and private
        label production.
      </p>
    </div>

    <div class="factory-feature">
      <div class="factory-image">
        <img
          src="/images/company/factory-building.webp"
          alt="GIFT IDEA LIMITED custom counter mat manufacturing facility"
          width="1600"
          height="900"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="factory-copy">
        <p class="eyebrow">Factory Direct Production</p>
        <h3>From Materials to Finished Products</h3>
        <p>
          Our production capability supports customized materials, printing,
          assembly, quality inspection and export preparation for international
          customers.
        </p>

        <ul>
          <li>Custom product specifications</li>
          <li>OEM and private label manufacturing</li>
          <li>Production quality inspection</li>
          <li>Export packaging and shipping support</li>
        </ul>

        <a href="/company-profile/" class="text-link">
          Learn About Our Company <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <div class="factory-collage">
      <img
        src="/images/company/factory-production-collage.webp"
        alt="OEM counter mat manufacturing process including printing, warehouse and production equipment"
        width="1600"
        height="900"
        loading="lazy"
        decoding="async"
      />
    </div>
  </section>

  <!-- Manufacturing Process -->
  <section class="process">
    <div class="section-header">
      <p class="eyebrow">Manufacturing Process</p>
      <h2>From Concept to Global Delivery</h2>
      <p>
        A clear OEM workflow designed to keep specifications, quality and
        delivery aligned from the first discussion through final shipment.
      </p>
    </div>

    <div class="steps">
      {processSteps.map((step, index) => (
        <article class="step">
          <div class="number">{step.number}</div>
          {index < processSteps.length - 1 && <div class="step-line" aria-hidden="true"></div>}
          <h3>{step.title}</h3>
          <p>{step.desc}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- Industries -->
  <section class="industries">
    <div class="section-header">
      <p class="eyebrow">Industries We Serve</p>
      <h2>Supporting Brands Across Multiple Markets</h2>
      <p>
        Flexible custom counter mat solutions for retail, hospitality,
        beverage, promotional and corporate applications.
      </p>
    </div>

    <div class="industry-grid">
      {industries.map((industry) => (
        <article class="industry-card">
          <img
            src={industry.image}
            alt={industry.alt}
            width="800"
            height="600"
            loading="lazy"
            decoding="async"
          />
          <div class="industry-content">
            <h3>{industry.title}</h3>
            <p>{industry.desc}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Global Export -->
  <section class="global">
    <div class="section-header">
      <p class="eyebrow">Global Export Capability</p>
      <h2>Serving International Markets</h2>
      <p>
        Supporting distributors, retailers and brands with reliable production
        and worldwide delivery.
      </p>
    </div>

    <div class="global-image">
      <img
        src="/images/company/global-export-map.webp"
        alt="Global export markets for custom counter mats including North America, Europe, Asia, Middle East and Australia"
        width="1600"
        height="900"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="market-grid">
      <div>North America</div>
      <div>Europe</div>
      <div>Australia</div>
      <div>Asia</div>
      <div>Middle East</div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="final-cta" id="quote">
    <div class="final-cta-inner">
      <p class="eyebrow">Start Your OEM Project</p>
      <h2>Ready to Bring Your Brand to the Counter?</h2>
      <p>
        Tell us your product requirements, quantity, dimensions and target
        market. We can help develop the right custom counter mat solution.
      </p>

      <a href="/request-a-quote/" class="final-cta-button">
        Request a Quote <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

</Layout>

<style>
  body {
    margin: 0;
  }

  section {
    padding: 100px 24px;
  }

  .hero {
    padding: 0 24px;
    background: var(--primary);
    color: white;
  }

  .hero-inner {
    max-width: 1400px;
    min-height: 650px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 64px;
  }

  .hero-content {
    padding: 80px 0;
  }

  .hero .eyebrow {
    color: white;
  }

  h1 {
    font-size: clamp(2.8rem, 5.5vw, 4.5rem);
    line-height: 1.08;
    margin: 20px 0;
    max-width: 760px;
    letter-spacing: -0.03em;
  }

  h1 span {
    display: block;
  }

  h2 {
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    line-height: 1.15;
    margin: 0 0 20px;
    letter-spacing: -0.02em;
  }

  h3 {
    font-size: 1.25rem;
    line-height: 1.35;
  }

  .hero-text {
    max-width: 650px;
    margin: 0;
    color: rgba(255, 255, 255, 0.9);
    font-size: 1.15rem;
    line-height: 1.75;
  }

  .hero-media {
    overflow: hidden;
    border-radius: 24px;
    background: white;
    min-height: 430px;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.2);
    align-self: center;
  }

  .hero-media img {
    display: block;
    width: 100%;
    max-width: none;
    height: auto;
    object-fit: contain;
    object-position: right center;
    flex-shrink: 0;
  }

  .actions {
    margin-top: 34px;
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 14px 30px;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .btn:hover {
    transform: translateY(-2px);
  }

  .primary {
    background: var(--accent);
    color: white;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.16);
  }

  .secondary {
    background: white;
    color: var(--primary);
  }

  .hero-points {
    margin-top: 28px;
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    color: rgba(255, 255, 255, 0.88);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .trust-bar {
    max-width: 1400px;
    margin: 0 auto;
    padding: 34px 24px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    background: var(--gray);
    border: 1px solid var(--light-gray);
    border-radius: 16px;
    text-align: center;
  }

  .trust-bar strong,
  .trust-bar span {
    display: block;
  }

  .trust-bar strong {
    color: var(--primary);
    font-size: 1.25rem;
    margin-bottom: 6px;
  }

  .trust-bar span {
    color: var(--text);
    font-size: 0.92rem;
    font-weight: 600;
  }

  .section-header {
    max-width: 760px;
    margin: 0 auto 52px;
    text-align: center;
  }

  .section-header > p:last-child {
    color: #64748b;
    font-size: 1.05rem;
    line-height: 1.75;
    margin-bottom: 0;
  }

  .eyebrow {
    color: var(--primary);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.8rem;
    margin: 0 0 12px;
  }

  .product-grid {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .product-card {
    overflow: hidden;
    background: var(--gray);
    border: 1px solid var(--light-gray);
    border-radius: 18px;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .product-card:hover {
    transform: translateY(-5px);
    border-color: var(--primary);
    box-shadow: 0 14px 34px rgba(15, 23, 42, 0.08);
  }

  .product-image-link {
    display: block;
    overflow: hidden;
  }

  .product-card img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    background: white;
    transition: transform 0.35s ease;
  }

  .product-card:hover img {
    transform: scale(1.025);
  }

  .product-card-content {
    padding: 26px 28px 30px;
  }

  .product-card h3 {
    margin: 0 0 10px;
  }

  .product-card p {
    margin: 0 0 20px;
    color: #64748b;
    line-height: 1.65;
  }

  .card-link,
  .text-link {
    color: var(--primary);
    font-weight: 700;
    text-decoration: none;
  }

  .capabilities {
    background: var(--gray);
  }

  .capability-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
  }

  .capability-card {
    background: white;
    padding: 30px;
    border: 1px solid var(--light-gray);
    border-radius: 16px;
  }

  .capability-number {
    color: var(--primary);
    font-weight: 800;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    margin-bottom: 28px;
  }

  .capability-card h3 {
    margin: 0 0 12px;
  }

  .capability-card p {
    margin: 0;
    color: #64748b;
    line-height: 1.65;
  }

  .factory {
    max-width: 1400px;
    margin: 0 auto;
  }

  .factory-feature {
    display: grid;
    grid-template-columns: 1.4fr 0.8fr;
    gap: 52px;
    align-items: center;
  }

  .factory-image img,
  .factory-collage img,
  .global-image img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 20px;
  }

  .factory-copy h3 {
    margin: 0 0 16px;
    font-size: 1.8rem;
  }

  .factory-copy > p:not(.eyebrow) {
    color: #64748b;
    line-height: 1.75;
  }

  .factory-copy ul {
    margin: 24px 0;
    padding: 0;
    list-style: none;
  }

  .factory-copy li {
    padding: 9px 0;
    color: #334155;
    font-weight: 600;
  }

  .factory-copy li::before {
    content: "✓";
    color: var(--primary);
    font-weight: 800;
    margin-right: 10px;
  }

  .factory-collage {
    max-width: 1100px;
    margin: 42px auto 0;
  }

  .process {
    background: var(--gray);
  }

  .steps {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 20px;
  }

  .step {
    position: relative;
    text-align: center;
    padding: 10px 12px;
  }

  .number {
    position: relative;
    z-index: 2;
    width: 52px;
    height: 52px;
    margin: 0 auto 20px;
    border-radius: 50%;
    background: var(--primary);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.05rem;
    font-weight: 700;
  }

  .step-line {
    position: absolute;
    top: 26px;
    left: calc(50% + 28px);
    width: calc(100% - 36px);
    height: 1px;
    background: var(--light-gray);
  }

  .step h3 {
    margin: 0 0 12px;
    font-size: 1.1rem;
  }

  .step p {
    margin: 0;
    color: #64748b;
    font-size: 0.93rem;
    line-height: 1.65;
  }

  .industry-grid {
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .industry-card {
    overflow: hidden;
    background: var(--gray);
    border: 1px solid var(--light-gray);
    border-radius: 16px;
  }

  .industry-card img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    background: white;
  }

  .industry-content {
    padding: 24px;
  }

  .industry-content h3 {
    margin: 0 0 10px;
  }

  .industry-content p {
    margin: 0;
    color: #64748b;
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .global {
    max-width: 1400px;
    margin: 0 auto;
  }

  .global-image {
    max-width: 1200px;
    margin: 0 auto 34px;
  }

  .market-grid {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 14px;
  }

  .market-grid div {
    padding: 20px 14px;
    background: var(--gray);
    border: 1px solid var(--light-gray);
    border-radius: 12px;
    text-align: center;
    color: #334155;
    font-weight: 700;
  }

  .final-cta {
    background: #0b1529;
    color: #e2e8f0;
    text-align: center;
    padding: 90px 24px;
  }

  .final-cta-inner {
    max-width: 820px;
    margin: 0 auto;
  }

  .final-cta .eyebrow {
    color: #93c5fd;
  }

  .final-cta h2 {
    margin: 0;
    color: white;
    font-size: clamp(2.2rem, 4vw, 3.4rem);
  }

  .final-cta p:not(.eyebrow) {
    max-width: 680px;
    margin: 24px auto 0;
    color: #cbd5e1;
    font-size: 1.1rem;
    line-height: 1.75;
  }

  .final-cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-width: 240px;
    min-height: 58px;
    margin-top: 32px;
    padding: 16px 34px;
    border-radius: 999px;
    background: #ff7112;
