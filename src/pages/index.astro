---
import Layout from '../components/Layout.astro';

// CustomCounterMat Home Page v2.1
// Premium Industrial Manufacturer Design

const productLines = [
  {
    name: "Hard Surface Counter Mats",
    desc: "Durable commercial surfaces designed for long-term branding applications.",
    slug: "hard-surface-counter-mats",
    image: "/images/products/hard-surface-counter-mat.webp",
    alt: "Custom hard surface counter mat manufactured for retail brands and commercial applications"
  },
  {
    name: "Fabric Counter Mats",
    desc: "Soft-touch promotional mats with high-quality custom printing.",
    slug: "fabric-counter-mats",
    image: "/images/products/fabric-counter-mat.webp",
    alt: "Custom fabric counter mat with printed branding for promotional and retail displays"
  },
  {
    name: "Changeable Insert Counter Mats",
    desc: "Flexible solutions for seasonal campaigns and replaceable graphics.",
    slug: "changeable-insert-counter-mats",
    image: "/images/products/changeable-insert-counter-mat.webp",
    alt: "Changeable insert counter mat with replaceable graphics for flexible brand promotions"
  },
  {
    name: "Premium Bar Counter Mats",
    desc: "Heavy-duty mats developed for hospitality, bars, and beverage brands.",
    slug: "premium-bar-counter-mats",
    image: "/images/products/premium-bar-counter-mat.webp",
    alt: "Premium custom bar counter mat designed for hospitality and beverage brands"
  },
  {
    name: "Eco-friendly Counter Mats",
    desc: "Sustainable material options for responsible brand promotion.",
    slug: "eco-friendly-counter-mats",
    image: "/images/products/eco-friendly-counter-mats.webp",
    alt: "Eco-friendly custom counter mat made with sustainable materials for brand promotion"
  },
  {
    name: "Custom Shapes & Sizes",
    desc: "Fully customized dimensions and specifications for unique projects.",
    slug: "custom-shapes-sizes",
    image: "/images/products/custom-shapes-sizes-counter-mat.webp",
    alt: "Custom shaped counter mat manufactured in unique sizes for brand displays"
  },
  {
  name: "Duraframe Window Poster Frame",
  desc: "Custom magnetic display frames for retail windows, offices and promotional signage applications.",
  slug: "duraframe-window-poster-frame",
  image: "/images/products/duraframe-window-poster-frame.webp",
  alt: "Custom Duraframe Window Poster Frame OEM Manufacturer for Retail Displays"
  },
];

const capabilities = [
  {
    title: "Manufacturing Expertise",
    desc: "Complete production knowledge from material selection to finished products."
  },
  {
    title: "Custom Engineering",
    desc: "Every project is developed around your specifications and market needs."
  },
  {
    title: "Quality Control",
    desc: "Consistent production standards for international business partners."
  },
  {
    title: "Export Support",
    desc: "Professional documentation and shipping coordination worldwide."
  }
];

const trustItems = [
  {
    number: "13+",
    title: "Years Manufacturing Experience",
    desc: "Over 13 years of experience producing custom counter mats and promotional products for international customers."
  },
  {
    number: "OEM",
    title: "Private Label Service",
    desc: "Complete OEM support including custom materials, printing, packaging, and product development."
  },
  {
    number: "30+",
    title: "Export Markets",
    desc: "Serving distributors, retailers, and brands across North America, Europe, Asia, and global markets."
  },
  {
    number: "Factory",
    title: "Production Capability",
    desc: "Professional manufacturing processes with flexible customization for different project requirements."
  },
  {
    number: "QC",
    title: "Quality Control",
    desc: "Strict inspection standards to ensure consistent quality and reliable international delivery."
  }
];

const processSteps = [
  {
    number: "1",
    title: "Project Discussion",
    desc: "Understand your product requirements, quantity, target market, and application."
  },
  {
    number: "2",
    title: "Artwork & Specification Review",
    desc: "Review dimensions, materials, printing, colors, packaging, and technical requirements."
  },
  {
    number: "3",
    title: "Sample Approval",
    desc: "Produce samples for confirmation of appearance, materials, printing, and specifications."
  },
  {
    number: "4",
    title: "Mass Production",
    desc: "Manufacture according to the approved specifications with production and quality control."
  },
  {
    number: "5",
    title: "Global Delivery",
    desc: "Prepare export packaging, documentation, and coordinate shipment to your destination."
  }
];

const industries = [
  {
    title: "Retail Brands",
    desc: "Custom counter mats for retail displays, promotions, and branded point-of-sale environments."
  },
  {
    title: "Hospitality",
    desc: "Durable branded mats designed for hotels, restaurants, cafés, and hospitality environments."
  },
  {
    title: "Bars & Breweries",
    desc: "Custom promotional mats developed for bars, breweries, beverage brands, and drink promotions."
  },
  {
    title: "Food & Beverage",
    desc: "Branded counter mats supporting product launches, promotions, and food and beverage campaigns."
  },
  {
    title: "Promotional Agencies",
    desc: "OEM production support for agencies managing customized promotional products for their clients."
  },
  {
    title: "Corporate Branding",
    desc: "Custom branded mats for corporate events, campaigns, offices, and customer engagement programs."
  }
];
---

<Layout title="Custom Counter Mats | OEM Manufacturer & Private Label Supplier">

  <section class="hero">

    <p class="eyebrow">
      OEM Counter Mat Manufacturer
    </p>

    <h1>
      Custom Counter Mats
      Manufactured for Global Brands
    </h1>

    <p class="hero-text">
      OEM and private label counter mat manufacturing with
      custom materials, printing, packaging and worldwide
      export support.
    </p>

    <div class="actions">

      <a href="#quote" class="btn primary">
        Request a Quote
      </a>

      <a href="/products" class="btn secondary">

        View Products

      </a>

    </div>

  </section>


  <section class="trust-bar">

    <div>
      OEM Manufacturing
    </div>

    <div>
      Custom Solutions
    </div>

    <div>
      Factory Direct
    </div>

    <div>
      Global Shipping
    </div>

  </section>


  <section class="products">

    <div class="section-header">

      <p class="eyebrow">
        Product Solutions
      </p>

      <h2>
        Custom Counter Mat Product Lines
      </h2>

      <p>
        Professional OEM solutions designed for brands,
        distributors and promotional markets worldwide.
      </p>

    </div>


    <div class="grid">

      {productLines.map((product) => (

        <article class="card">

          <img
            src={product.image}
            alt={product.alt}
            width="1200"
            height="900"
            loading="lazy"
            decoding="async"
          />

          <h3>
            {product.name}
          </h3>

          <p>
            {product.desc}
          </p>

          <a href={`/products/${product.slug}/`}>
            Explore →
          </a>

        </article>

      ))}

    </div>

  </section>


  <section class="trust-section">

    <div class="section-header">

      <p class="eyebrow">
        Manufacturing Strength
      </p>

      <h2>
        Your Reliable OEM Counter Mat Partner
      </h2>

      <p>
        We combine manufacturing experience, customization capability,
        and export expertise to support global brands and distributors.
      </p>

    </div>


    <div class="trust-grid">

      {trustItems.map((item) => (

        <article class="trust-card">

          <div class="trust-number">
            {item.number}
          </div>

          <h3>
            {item.title}
          </h3>

          <p>
            {item.desc}
          </p>

        </article>

      ))}

    </div>

  </section>


  <section class="capabilities">

    <div class="section-header">

      <p class="eyebrow">
        Why Partner With Us
      </p>

      <h2>
        Built for Long-Term OEM Partnerships
      </h2>

      <p>
        We support global companies with reliable
        manufacturing, customization and export services.
      </p>

    </div>


    <div class="grid">

      {capabilities.map((item) => (

        <article class="card">

          <h3>
            {item.title}
          </h3>

          <p>
            {item.desc}
          </p>

        </article>

      ))}

    </div>

  </section>


  <section class="factory">

    <div class="section-header">

      <p class="eyebrow">
        Our Factory
      </p>

      <h2>
        Trusted OEM Manufacturing Capability
      </h2>

      <p>
        With 13+ years of manufacturing experience, we support
        global brands, distributors and promotional companies
        with reliable OEM and private label counter mat production.
      </p>

    </div>


    <div class="factory-building">

      <img
        src="/images/company/factory-building.webp"
        alt="GIFT IDEA LIMITED custom counter mat manufacturing facility"
        width="1600"
        height="900"
        loading="lazy"
        decoding="async"
      />

    </div>


    <div class="factory-info">

      <div>
        <strong>13+ Years</strong>
        <span>Manufacturing Experience</span>
      </div>

      <div>
        <strong>OEM / Private Label</strong>
        <span>Custom Manufacturing Service</span>
      </div>

      <div>
        <strong>Global Export</strong>
        <span>International Market Support</span>
      </div>

      <div>
        <strong>Quality Control</strong>
        <span>Production Quality Management</span>
      </div>

    </div>


    <div class="factory-collage">

      <img
        src="/images/company/factory-production-collage.webp"
        alt="OEM counter mat manufacturing process including printing, warehouse and production equipment"
        width="1600"
        height="1200"
        loading="lazy"
        decoding="async"
      />

    </div>

  </section>


  <section class="process">

    <div class="section-header">

      <p class="eyebrow">
        Manufacturing Process
      </p>

      <h2>
        From Concept to Global Delivery
      </h2>

    </div>


    <div class="steps">

      {processSteps.map((step) => (

        <div class="step">

          <div class="number">
            {step.number}
          </div>

          <h3>
            {step.title}
          </h3>

          <p>
            {step.desc}
          </p>

        </div>

      ))}

    </div>

  </section>


  <section class="industries">

    <div class="section-header">

      <p class="eyebrow">
        Industries We Serve
      </p>

      <h2>
        Supporting Brands Across Multiple Markets
      </h2>

    </div>


    <div class="industry-grid">

      {industries.map((industry) => (

        <div class="industry">

          <h3>
            {industry.title}
          </h3>

          <p>
            {industry.desc}
          </p>

        </div>

      ))}

    </div>

  </section>


  <section class="global">

    <div class="section-header">

      <p class="eyebrow">
        Global Export Capability
      </p>

      <h2>
        Serving International Markets
      </h2>

      <p>
        Supporting distributors, retailers and brands
        with reliable production and worldwide delivery.
      </p>

    </div>


    <img
      src="/images/company/global-export-map.webp"
      alt="Global export markets for custom counter mats including North America, Europe, Asia, Middle East and Australia"
      width="1600"
      height="900"
      loading="lazy"
      decoding="async"
    />


    <div class="market-grid">

      <div>North America</div>
      <div>Europe</div>
      <div>Australia</div>
      <div>Asia</div>
      <div>Middle East</div>

    </div>

  </section>


  <!-- Final Homepage CTA -->
  <section class="final-cta" id="quote">

    <div class="final-cta-inner">

      <h2>
        Ready to Bring Your Brand to the Counter?
      </h2>

      <p>
        We help businesses worldwide create professional,
        high-quality custom counter mats.
      </p>

      <a href="mailto:countermat25@gmail.com" class="final-cta-button">
        Request a Quote
      </a>

    </div>

  </section>

</Layout>


<style>

body {
  margin: 0;
}


/* Hero */

.hero {
  text-align: center;
  padding: 160px 24px;
  background: var(--primary);
  color: white;
}


.hero .eyebrow {
  color: white;
}


h1 {
  font-size: clamp(2.8rem, 6vw, 4.5rem);
  line-height: 1.1;
  margin: 20px auto;
  max-width: 900px;
}


h2 {
  font-size: 2.4rem;
  margin-bottom: 20px;
}


h3 {
  font-size: 1.25rem;
}


.hero-text {
  max-width: 720px;
  margin: auto;
  color: rgba(255,255,255,0.9);
  font-size: 1.15rem;
  line-height: 1.7;
}


.section-header {
  max-width: 700px;
  margin: 0 auto 50px;
  text-align: center;
}


.section-header p {
  color: #94a3b8;
  font-size: 1.15rem;
  line-height: 1.7;
}


.eyebrow {
  color: var(--primary);
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
  font-size: .85rem;
}


.actions {
  margin-top: 40px;
  display: flex;
  justify-content: center;
  gap: 20px;
  flex-wrap: wrap;
}


.btn {
  padding: 14px 32px;
  border-radius: 8px;
  text-decoration: none;
  font-weight: 700;
  transition: .25s;
}


.btn:hover {
  transform: translateY(-2px);
}


.primary {
  background: var(--accent);
  color: white;
  padding: 18px 48px;
  border-radius: 50px;
  font-size: 1.2rem;
}

.secondary {
  background: white;
  border: 1px solid white;
  color: var(--primary);
  padding: 18px 48px;
  border-radius: 50px;
  font-size: 1.2rem;
}


/* Trust Bar */

.trust-bar {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  background: var(--gray);
  border-radius: 16px;
  text-align: center;
  font-weight: 700;
  padding: 32px 20px;
  gap: 20px;
}


/* Cards */

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 24px;
}


.card {
  padding: 32px;
  background: var(--gray);
  border: 1px solid var(--light-gray);
  border-radius: 16px;
  transition: .25s;
}


.card img {
  width: 100%;
  height: 220px;
  object-fit: cover;
  border-radius: 12px;
  margin-bottom: 24px;
  display: block;
}


.card:hover {
  border-color: var(--primary);
  transform: translateY(-5px);
}


.card a {
  color: var(--primary);
  font-weight: 700;
  text-decoration: none;
}


/* Factory */

.factory-building img,
.factory-collage img {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 20px;
}


.factory-building {
  margin-bottom: 40px;
}


.factory-info {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
  margin-bottom: 50px;
}


.factory-info > div {
  padding: 28px 20px;
  background: var(--gray);
  border: 1px solid var(--light-gray);
  border-radius: 12px;
  text-align: center;
}


.factory-info strong {
  display: block;
  font-size: 1.15rem;
  margin-bottom: 8px;
}


.factory-info span {
  display: block;
  color: #94a3b8;
  font-size: .95rem;
}


.factory-collage {
  max-width: 900px;
  margin: 0 auto;
}


/* Manufacturing Process */

.steps {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 24px;
}


.step {
  text-align: center;
  padding: 10px;
}


.number {
  width: 52px;
  height: 52px;
  margin: 0 auto 20px;
  border-radius: 50%;
  background: var(--primary);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.1rem;
  font-weight: 700;
}


.step h3 {
  margin: 0 0 12px;
  font-size: 1.15rem;
  line-height: 1.4;
}


.step p {
  margin: 0;
  color: #94a3b8;
  font-size: .95rem;
  line-height: 1.6;
}


/* Global Export Map */

.global > img {
  display: block;
  width: 100%;
  max-width: 100%;
  height: auto;
  border-radius: 20px;
  margin-bottom: 40px;
}


/* Industry and Market */

.industry-grid,
.market-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 20px;
}


.industry {
  padding: 28px 24px;
  background: var(--gray);
  border: 1px solid var(--light-gray);
  border-radius: 12px;
  text-align: center;
}


.industry h3 {
  margin: 0 0 12px;
  font-size: 1.15rem;
}


.industry p {
  margin: 0;
  color: #94a3b8;
  font-size: .95rem;
  line-height: 1.6;
}


.market-grid div {
  padding: 24px;
  background: var(--gray);
  border: 1px solid var(--light-gray);
  border-radius: 12px;
  text-align: center;
  font-weight: 600;
}


/* Manufacturing Trust Section */

.trust-section {
  background: var(--gray);
  border-radius: 24px;
}


.trust-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 24px;
}


.trust-card {
  background: white;
  padding: 32px;
  border-radius: 16px;
  border: 1px solid var(--light-gray);
}


.trust-number {
  font-size: 2.5rem;
  font-weight: 800;
  color: var(--primary);
  margin-bottom: 16px;
}


.trust-card h3 {
  margin-bottom: 12px;
}


.trust-card p {
  color: #94a3b8;
  line-height: 1.7;
}


/* Final CTA */

.final-cta {
  background: #0b1529;
  color: #e2e8f0;
  text-align: center;
  padding: 80px 24px 92px;
}

.final-cta-inner {
  max-width: 1400px;
  margin: 0 auto;
}

.final-cta h2 {
  margin: 0;
  color: #e2e8f0;
  font-size: clamp(2.5rem, 4vw, 3.5rem);
  line-height: 1.15;
  font-weight: 700;
}

.final-cta p {
  max-width: 1350px;
  margin: 72px auto 0;
  color: #e2e8f0;
  font-size: clamp(1.75rem, 2.8vw, 2.5rem);
  line-height: 1.35;
  font-weight: 400;
}

.final-cta-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 510px;
  min-height: 140px;
  margin-top: 72px;
  padding: 24px 48px;
  border-radius: 999px;
  background: #ff7112;
  color: #ffffff;
  font-size: 2.5rem;
  line-height: 1;
  font-weight: 700;
  text-decoration: none;
  transition:
    transform 0.2s ease,
    background 0.2s ease;
}

.final-cta-button:hover {
  background: #f2650a;
  transform: translateY(-2px);
}


@media (max-width: 768px) {

  .trust-bar {
    grid-template-columns: 1fr;
  }

  .factory-info {
    grid-template-columns: 1fr;
  }

  .steps {
    grid-template-columns: 1fr;
    gap: 40px;
  }

  h1 {
    font-size: 2.5rem;
  }

  .final-cta {
    padding: 60px 20px 72px;
  }

  .final-cta h2 {
    font-size: 2.25rem;
  }

  .final-cta p {
    margin-top: 48px;
    font-size: 1.5rem;
  }

  .final-cta-button {
    min-width: 0;
    width: 100%;
    max-width: 420px;
    min-height: 96px;
    margin-top: 48px;
    font-size: 2rem;
  }

}

</style>