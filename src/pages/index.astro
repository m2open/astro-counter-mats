---
const title = "OEM Custom Counter Mats - Premium Quality for Global Brands";
---

<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style>
        :root {
            --primary: #3b82f6;
            --accent: #f97316;
        }
        body {
            font-family: system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
            margin: 0;
            padding: 0;
            background: #0f172a;
            color: #e2e8f0;
            line-height: 1.7;
        }
        header {
            background: linear-gradient(135deg, #1e3a8a, #3b82f6);
            padding: 160px 20px 120px;
            text-align: center;
        }
        h1 {
            font-size: 3.8rem;
            margin: 0 0 20px 0;
            font-weight: 700;
        }
        .subtitle {
            font-size: 1.45rem;
            max-width: 820px;
            margin: 0 auto 40px;
            opacity: 0.95;
        }
        .btn {
            background: var(--accent);
            color: white;
            padding: 18px 50px;
            font-size: 1.25rem;
            font-weight: 600;
            border-radius: 50px;
            text-decoration: none;
            display: inline-block;
            transition: all 0.3s;
        }
        .btn:hover {
            background: #ea580c;
            transform: translateY(-3px);
        }
        section {
            padding: 100px 20px;
            text-align: center;
        }
        .features {
            background: #1e2937;
        }
        .feature-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 40px;
            max-width: 1200px;
            margin: 60px auto;
        }
        .feature {
            background: #334155;
            padding: 45px 30px;
            border-radius: 20px;
        }
        footer {
            background: #020617;
            padding: 80px 20px;
            text-align: center;
        }
    </style>
</head>
<body>
    <header>
        <h1>OEM Custom Counter Mats</h1>
        <p class="subtitle">
            High-quality custom bar mats, counter mats, and promotional flooring solutions<br>
            manufactured for restaurants, bars, casinos, retail stores and global brands.
        </p>
        <a href="#contact" class="btn">Request Custom Quote</a>
    </header>

    <section class="features">
        <h2>Why Global Clients Choose Us</h2>
        <div class="feature-grid">
            <div class="feature">
                <h3>Custom Branding</h3>
                <p>Logo printing, full-color designs, custom shapes and sizes according to your specifications.</p>
            </div>
            <div class="feature">
                <h3>Premium Materials</h3>
                <p>Heavy-duty natural rubber base + high-absorbency fabric top. Built to last.</p>
            </div>
            <div class="feature">
                <h3>Reliable Global Export</h3>
                <p>Experienced in international shipping with consistent quality control.</p>
            </div>
            <div class="feature">
                <h3>Flexible MOQ</h3>
                <p>From small test orders to large volume production — we accommodate your needs.</p>
            </div>
        </div>
    </section>

    <section id="contact">
        <h2>Let's Bring Your Brand to Every Counter</h2>
        <p style="font-size: 1.35rem; max-width: 700px; margin: 30px auto;">
            Tell us your requirements and we will provide a competitive quote within 24 hours.
        </p>
        <a href="mailto:your-email@example.com" class="btn">Get in Touch →</a>
    </section>

    <footer>
        <p><strong>Email:</strong> your-email@example.com</p>
        <p><strong>WhatsApp / WeChat:</strong> +[Your Number]</p>
        <p><strong>X:</strong> @yourusername</p>
        <p style="margin-top: 40px; opacity: 0.7;">© 2026 Your Company Name. All Rights Reserved.</p>
    </footer>
</body>
</html>