---
// src/pages/faq/index.astro
import Header from '../../components/Header.astro';
import { craftQuery } from '../../lib/craft';

const CATEGORIES = [
  { slug: 'ordering', title: 'Ordering', intro: 'MOQs, quotes, production timelines, and reorders.' },
  { slug: 'payment', title: 'Payment', intro: 'Deposits, accepted payment methods, and volume pricing.' },
  { slug: 'artwork-design', title: 'Artwork & Design', intro: 'File formats, proofs, resolution, and design support.' },
  { slug: 'printing', title: 'Printing', intro: 'Color matching, printing methods, and print durability.' },
  { slug: 'product-materials', title: 'Product & Materials', intro: 'Materials, sizes, shapes, and durability of our mats.' },
  { slug: 'packaging', title: 'Packaging', intro: 'Export packaging, retail-ready options, and damage claims.' },
  { slug: 'shipping-logistics', title: 'Shipping & Logistics', intro: 'Countries served, couriers, delivery times, and customs.' },
  { slug: 'company-oem', title: 'Company & OEM', intro: 'Who we are, OEM services, certifications, and how to reach us.' },
];

const query = `
  query AllFaqs {
    entries(section: "faq", limit: 200) {
      ... on faq_faqQuestion_Entry {
        question
        shortAnswer
        answer
        faqSortOrder
        featured
        faqCategory {
          title
          slug
        }
      }
    }
  }
`;

const data = await craftQuery(query);
const allEntries = data?.entries || [];

const featured = allEntries
  .filter((e) => e.featured)
  .sort((a, b) => (a.faqSortOrder ?? 0) - (b.faqSortOrder ?? 0));

function slugify(text) {
  return text
    .toLowerCase()
    .replace(/[^\w\s-]/g, '')
    .trim()
    .replace(/\s+/g, '-');
}

const pageTitle = 'Frequently Asked Questions - Custom Counter Mats';
const pageDescription = 'Answers to common questions about ordering, artwork, materials, shipping, and OEM services for custom counter mats.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: featured.map((e) => ({
    '@type': 'Question',
    name: e.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: e.shortAnswer || e.answer,
    },
  })),
};
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDescription} />
  <link rel="canonical" href="https://customcountermat.com/faq" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body style="margin: 0; background: #1e2937; color: white; font-family: system-ui, sans-serif;">
  <Header currentPage="faq" />

  <main style="max-width: 1000px; margin: 0 auto; padding: 3rem 20px;">
    <h1 style="font-size: 2.6rem; margin-bottom: 0.5rem;">Frequently Asked Questions</h1>
    <p style="font-size: 1.15rem; line-height: 1.6; color: #cbd5e1; margin-bottom: 3rem; max-width: 700px;">
      Everything buyers ask us about ordering, artwork, materials, shipping, and OEM partnerships — organized by topic below.
    </p>

    <!-- Category cards -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem; margin-bottom: 3.5rem;">
      {CATEGORIES.map((cat) => (
        <a
          href={`/faq/${cat.slug}`}
          style="display: block; background: #26334a; border: 1px solid #334155; border-radius: 10px; padding: 1.5rem; text-decoration: none; color: white;"
        >
          <h2 style="font-size: 1.25rem; margin: 0 0 0.5rem 0; color: #f97316;">{cat.title}</h2>
          <p style="font-size: 0.95rem; color: #94a3b8; margin: 0; line-height: 1.5;">{cat.intro}</p>
        </a>
      ))}
    </div>

    <!-- Featured / most asked -->
    {featured.length > 0 && (
      <div style="margin-bottom: 3rem;">
        <h2 style="font-size: 1.6rem; margin-bottom: 1.25rem;">Most Asked Questions</h2>
        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
          {featured.map((entry) => (
            <details
              id={slugify(entry.question)}
              style="background: #26334a; border: 1px solid #334155; border-radius: 8px; padding: 1rem 1.25rem;"
            >
              <summary style="cursor: pointer; font-weight: 600; font-size: 1.05rem; color: white; list-style: none;">
                {entry.question}
              </summary>
              <div style="margin-top: 0.9rem; padding-top: 0.9rem; border-top: 1px solid #334155; color: #cbd5e1; line-height: 1.6; font-size: 1rem;">
                <p set:html={entry.answer} />
                <a
                  href={`/faq/${entry.faqCategory?.[0]?.slug}#${slugify(entry.question)}`}
                  style="color: #f97316; font-size: 0.9rem; text-decoration: none;"
                >
                  View in {entry.faqCategory?.[0]?.title} &rarr;
                </a>
              </div>
            </details>
          ))}
        </div>
      </div>
    )}

    <!-- CTA band -->
    <div style="margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid #334155;">
      <p style="color: #cbd5e1; margin-bottom: 1rem;">Can't find what you're looking for?</p>
      <a
        href="/contact"
        style="display: inline-block; background: #f97316; color: white; padding: 0.9rem 2rem; border-radius: 6px; text-decoration: none; font-weight: 600;"
      >Request a Quote</a>

      <div style="display: flex; gap: 1rem; margin-top: 1rem; flex-wrap: wrap;">
        <a
          href="https://wa.me/8613168787818"
          target="_blank"
          rel="noopener noreferrer"
          style="display: inline-flex; align-items: center; gap: 0.5rem; background: transparent; color: #f97316; border: 2px solid #f97316; padding: 0.75rem 1.75rem; border-radius: 6px; text-decoration: none; font-weight: 600;"
        >WhatsApp</a>

        <a
          href="https://x.com/countermat_2035"
          target="_blank"
          rel="noopener noreferrer"
          style="display: inline-flex; align-items: center; gap: 0.5rem; background: transparent; color: #f97316; border: 2px solid #f97316; padding: 0.75rem 1.75rem; border-radius: 6px; text-decoration: none; font-weight: 600;"
        >XChat</a>
      </div>
    </div>
  </main>
</body>
</html>