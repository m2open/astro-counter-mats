---
// src/pages/products/[slug].astro
import Layout from '../../components/Layout.astro';

const CRAFT_API = 'https://a744181dea.nxcli.io/api';

export async function getStaticPaths() {
  const query = `
    query AllProductSlugs {
      entries(section: "products") {
        slug
      }
    }
  `;

  const response = await fetch('https://a744181dea.nxcli.io/api', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ query }),
  });

  const { data } = await response.json();

  return data.entries.map((entry) => ({
    params: { slug: entry.slug },
  }));
}

const { slug } = Astro.params;

const query = `
  query ProductBySlug($slug: [String]) {
    entry(section: "products", slug: $slug) {
      title
      slug
      ... on products_default_Entry {
        productDescription
        material
        thickness
        printing
        priceRange
        productImages {
          url
          title
        }
        downloadPdf {
          url
          filename
        }
        applicationsText
        applicationsImage {
          url
          title
        }
        packageDimension
        grossWeight
        orderInformation {
          ... on orderInformation_TableRow {
            content
            qty
            unit
          }
        }
        relatedFaqs {
          ... on faq_faqQuestion_Entry {
            question
            shortAnswer
            faqCategory {
              title
              slug
            }
          }
        }
      }
    }
  }
`;

const response = await fetch('https://a744181dea.nxcli.io/api', {
  method: 'POST',
  headers: { 'Content-Type': 'application/json' },
  body: JSON.stringify({ query, variables: { slug: [slug] } }),
});

const { data } = await response.json();
const product = data.entry;

if (!product) {
  return Astro.redirect('/404');
}

function slugify(text) {
  return text
    .toLowerCase()
    .replace(/[^\w\s-]/g, '')
    .trim()
    .replace(/\s+/g, '-');
}
---

<Layout title={`${product.title} - Custom Counter Mats`}>

  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <div style="margin: 0; background: #1e2937; color: white; font-family: system-ui, sans-serif;">

  <main style="max-width: 900px; margin: 0 auto; padding: 3rem 20px;">
    <a href="/products" style="color: #f97316; text-decoration: none; font-size: 0.95rem;">&larr; Back to Products</a>

    <h1 style="font-size: 2.4rem; margin-top: 1rem;">{product.title}</h1>

    {product.productImages?.length > 0 && (
      <img
        src={product.productImages[0].url}
        alt={product.productImages[0].title || product.title}
        style="width: 100%; max-width: 500px; border-radius: 8px; margin: 1.5rem 0;"
      />
    )}

    {product.productDescription && (
      <p style="font-size: 1.1rem; line-height: 1.6; color: #cbd5e1;">
        {product.productDescription}
      </p>
    )}

    <table style="width: 100%; border-collapse: collapse; margin-top: 2rem;">
      <tbody>
        {product.material && (
          <tr style="border-bottom: 1px solid #334155;">
            <td style="padding: 0.75rem 0; font-weight: 600; width: 30%;">Material</td>
            <td style="padding: 0.75rem 0; color: #cbd5e1;">{product.material}</td>
          </tr>
        )}
        {product.thickness && (
          <tr style="border-bottom: 1px solid #334155;">
            <td style="padding: 0.75rem 0; font-weight: 600;">Thickness</td>
            <td style="padding: 0.75rem 0; color: #cbd5e1;">{product.thickness}</td>
          </tr>
        )}
        {product.printing && (
          <tr style="border-bottom: 1px solid #334155;">
            <td style="padding: 0.75rem 0; font-weight: 600;">Printing</td>
            <td style="padding: 0.75rem 0; color: #cbd5e1;">{product.printing}</td>
          </tr>
        )}
        {product.priceRange && (
          <tr style="border-bottom: 1px solid #334155;">
            <td style="padding: 0.75rem 0; font-weight: 600;">Price Range</td>
            <td style="padding: 0.75rem 0; color: #cbd5e1;">{product.priceRange}</td>
          </tr>
        )}
      </tbody>
    </table>

    {product.productImages?.length > 1 && (
      <div style="display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 2rem;">
        {product.productImages.slice(1).map((img) => (
          <img src={img.url} alt={img.title || product.title} style="width: 150px; border-radius: 6px;" />
        ))}
      </div>
    )}

    {product.orderInformation?.length > 0 && (
      <div style="margin-top: 2.5rem;">
        <h2 style="font-size: 1.5rem; margin-bottom: 0.75rem;">Order Information</h2>
        <p style="color: #94a3b8; margin-bottom: 0.75rem;">Line items for this product's order/packing details.</p>
        <table style="width: 100%; border-collapse: collapse; border: 1px solid #334155;">
          <thead>
            <tr>
              <th style="text-align: center; padding: 0.6rem 0.5rem; color: #94a3b8; border: 1px solid #334155;">Content</th>
              <th style="text-align: center; padding: 0.6rem 0.5rem; color: #94a3b8; border: 1px solid #334155;">Qty</th>
              <th style="text-align: center; padding: 0.6rem 0.5rem; color: #94a3b8; border: 1px solid #334155;">Unit</th>
              <th style="text-align: center; padding: 0.6rem 0.5rem; color: #94a3b8; border: 1px solid #334155;">Package Dimension</th>
              <th style="text-align: center; padding: 0.6rem 0.5rem; color: #94a3b8; border: 1px solid #334155;">Gross Weight</th>
            </tr>
          </thead>
          <tbody>
            {product.orderInformation.map((row, i) => (
              <tr>
                <td style="padding: 0.6rem 0.5rem; color: #cbd5e1; text-align: center; border: 1px solid #334155;">{row.content}</td>
                <td style="padding: 0.6rem 0.5rem; color: #cbd5e1; text-align: center; border: 1px solid #334155;">{row.qty}</td>
                <td style="padding: 0.6rem 0.5rem; color: #cbd5e1; text-align: center; border: 1px solid #334155;">{row.unit}</td>
                {i === 0 && (product.packageDimension || product.grossWeight) && (
  <>
    <td
      rowspan={product.orderInformation.length}
      style="padding: 0.7rem 0.5rem; color: #e2e8f0; vertical-align: middle; text-align: center; background: #1e2937; border: 1px solid #334155;"
    >
      {product.packageDimension}
    </td>
    <td
      rowspan={product.orderInformation.length}
      style="padding: 0.7rem 0.5rem; color: #e2e8f0; vertical-align: middle; text-align: center; background: #1e2937; border: 1px solid #334155;"
    >
      {product.grossWeight}
    </td>
  </>
                )}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    {product.applicationsText && (
      <div style="margin-top: 2.5rem;">
        <h2 style="font-size: 1.5rem; margin-bottom: 0.75rem;">Applications</h2>
        <p style="font-size: 1.05rem; line-height: 1.6; color: #cbd5e1;">
          {product.applicationsText}
        </p>
        {product.applicationsImage?.length > 0 && (
          <img
            src={product.applicationsImage[0].url}
            alt={product.applicationsImage[0].title || 'Applications'}
            style="width: 100%; max-width: 500px; border-radius: 8px; margin-top: 1rem;"
          />
        )}
      </div>
    )}

    {product.downloadPdf?.length > 0 && (
      <div style="margin-top: 2.5rem;">
        <h2 style="font-size: 1.5rem; margin-bottom: 0.75rem;">Download</h2>
        <a
          href={product.downloadPdf[0].url}
          target="_blank"
          rel="noopener noreferrer"
          style="display: inline-flex; align-items: center; gap: 0.5rem; background: #334155; color: white; padding: 0.75rem 1.5rem; border-radius: 6px; text-decoration: none; font-weight: 600;"
        >
          Download PDF ({product.downloadPdf[0].filename})
        </a>
      </div>
    )}

    {product.relatedFaqs?.length > 0 && (
      <div style="margin-top: 2.5rem;">
        <h2 style="font-size: 1.5rem; margin-bottom: 0.75rem;">Related Questions</h2>
        <div style="display: flex; flex-direction: column; gap: 0.6rem;">
          {product.relatedFaqs.map((faq) => {
            const catSlug = faq.faqCategory?.[0]?.slug;
            const qSlug = slugify(faq.question);
            return (
              <details
                style="background: #26334a; border: 1px solid #334155; border-radius: 8px; padding: 0.9rem 1.15rem;"
              >
                <summary
                  style="cursor: pointer; font-weight: 600; font-size: 1rem; color: white; list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 1rem;"
                >
                  <span>{faq.question}</span>
                  <span class="faq-chevron" aria-hidden="true"></span>
                </summary>
                {faq.shortAnswer && (
                  <p style="margin: 0.9rem 0 0 0; padding-top: 0.9rem; border-top: 1px solid #334155; color: #cbd5e1; font-size: 0.9rem; line-height: 1.5;">
                    {faq.shortAnswer}
                  </p>
                )}
                <a
                  href={`/faq/${catSlug}#${qSlug}`}
                  style="display: inline-block; margin-top: 0.75rem; color: #f97316; font-size: 0.85rem; text-decoration: none;"
                >
                  View full answer &rarr;
                </a>
              </details>
            );
          })}
        </div>
        <a href="/faq" style="display: inline-block; margin-top: 1rem; color: #f97316; text-decoration: none; font-size: 0.9rem;">
          View all FAQs &rarr;
        </a>
      </div>
    )}

    <!-- CTA band -->
    <div style="margin-top: 2.5rem;">
      <a
        id="btn-quote"
        href="/request-a-quote"
        class="cta-btn cta-btn-primary"
        style="display: inline-block; background: #f97316; color: white; padding: 0.9rem 2rem; border-radius: 6px; text-decoration: none; font-weight: 600;"
      >Request a Quote</a>

      <div style="display: flex; gap: 1rem; margin-top: 1rem; flex-wrap: wrap;">
        <a
          id="btn-whatsapp"
          href="https://wa.me/8613168787818"
          target="_blank"
          rel="noopener noreferrer"
          class="cta-btn cta-btn-outline"
          style="display: inline-flex; align-items: center; gap: 0.5rem; background: transparent; color: #f97316; border: 2px solid #f97316; padding: 0.75rem 1.75rem; border-radius: 6px; text-decoration: none; font-weight: 600;"
        >WhatsApp</a>

        <a
          id="btn-xchat"
          href="https://x.com/countermat_2035"
          target="_blank"
          rel="noopener noreferrer"
          class="cta-btn cta-btn-outline"
          style="display: inline-flex; align-items: center; gap: 0.5rem; background: transparent; color: #f97316; border: 2px solid #f97316; padding: 0.75rem 1.75rem; border-radius: 6px; text-decoration: none; font-weight: 600;"
        >XChat</a>
      </div>
    </div>
  </main>
  </div>

<script>
  const ctaButtons = document.querySelectorAll('.cta-btn');
  const STORAGE_KEY = 'lastClickedCta';

  function setActive(activeBtn) {
    ctaButtons.forEach((b) => {
      b.style.background = 'transparent';
      b.style.color = '#f97316';
      b.style.border = '2px solid #f97316';
    });
    activeBtn.style.background = '#f97316';
    activeBtn.style.color = 'white';
    activeBtn.style.border = '2px solid #f97316';
  }

  // Restore last-clicked state on page load
  const lastClicked = localStorage.getItem(STORAGE_KEY);
  if (lastClicked) {
    const savedBtn = document.getElementById(lastClicked);
    if (savedBtn) {
      setActive(savedBtn);
    }
  }

  // Save + apply on click
  ctaButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      setActive(btn);
      localStorage.setItem(STORAGE_KEY, btn.id);
    });
  });
</script>
</Layout>


<style>
.faq-chevron {
  display: inline-block;
  width: 9px;
  height: 9px;
  border-right: 2px solid #ffffff;
  border-bottom: 2px solid #ffffff;
  transform: rotate(45deg);
  flex: 0 0 9px;
  margin-right: 4px;
  margin-top: -5px;
  transition: transform 0.2s ease;
}

details[open] .faq-chevron {
  transform: rotate(225deg);
  margin-top: 5px;
}

details summary::-webkit-details-marker {
  display: none;
}
</style>
