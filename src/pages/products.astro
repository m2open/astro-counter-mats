---
import Layout from '../components/Layout.astro';
import { craftQuery } from '../lib/craft';

const data = await craftQuery('{ entries(section: "products") { id title slug ... on products_default_Entry { productDescription material thickness printing priceRange productImages { url alt } } } }');
const products = data.entries as any[];
---

<Layout title="Products - OEM Custom Counter Mats">
    <!-- Hero -->
    <section style="padding: 140px 20px 80px; text-align: center; background: linear-gradient(135deg, #1e40af, #3b82f6);">
        <h1 style="font-size: 3.5rem; margin-bottom: 20px;">Our Products</h1>
        <p style="font-size: 1.35rem; max-width: 800px; margin: 0 auto;">
            Premium custom counter mats designed for bars, restaurants, retail stores, and promotional campaigns worldwide.
        </p>
    </section>

    <section style="padding: 100px 20px; max-width: 1200px; margin: 0 auto;">
        {products.map((product, index) => (
            <div style={`display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; margin-bottom: 140px;`}>
                <div style={index % 2 !== 0 ? 'order: 2;' : ''}>
                    {product.productImages[0] && (
                        <img src={product.productImages[0].url} alt={product.productImages[0].alt || product.title} style="width:100%; border-radius: 16px; box-shadow: 0 15px 40px rgba(0,0,0,0.3);" />
                    )}
                </div>
                <div>
                    <h2 style="font-size: 2.3rem;">{product.title}</h2>
                    <p style="font-size: 1.2rem; line-height: 1.8; margin: 25px 0;">{product.productDescription}</p>

                    <h3 style="margin: 30px 0 15px 0;">Specifications</h3>
                    <table style="width:100%; border-collapse: collapse; margin-bottom: 30px;">
                        <tr style="border-bottom: 1px solid #334155;"><td style="padding: 12px 0; font-weight: 600;">Material</td><td style="padding: 12px 0;">{product.material}</td></tr>
                        <tr style="border-bottom: 1px solid #334155;"><td style="padding: 12px 0; font-weight: 600;">Thickness</td><td style="padding: 12px 0;">{product.thickness}</td></tr>
                        <tr style="border-bottom: 1px solid #334155;"><td style="padding: 12px 0; font-weight: 600;">Size</td><td style="padding: 12px 0;">Custom sizes available</td></tr>
                        <tr><td style="padding: 12px 0; font-weight: 600;">Printing</td><td style="padding: 12px 0;">{product.printing}</td></tr>
                    </table>

                    <a href="/contact" style="background:#f97316; color:white; padding:16px 40px; border-radius:50px; text-decoration:none; font-weight:bold; display:inline-block;">
                        Request a Quote
                    </a>
                </div>
            </div>
        ))}
    </section>
</Layout>
