---
import Layout from '../components/Layout.astro';
---

<Layout title="Products - Custom Counter Mats">
    <section style="padding: 120px 20px 80px; text-align: center; background: linear-gradient(135deg, #1e40af, #3b82f6);">
        <h1 style="font-size: 3.2rem; margin-bottom: 20px;">Our Products</h1>
        <p style="font-size: 1.3rem; max-width: 700px; margin: 0 auto;">
            High-quality custom counter mats designed for bars, restaurants, retail stores, and promotional use.
        </p>
    </section>

    <section style="padding: 80px 20px;">
        <div style="max-width: 1200px; margin: 0 auto;">
            <!-- Product 1 -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; margin-bottom: 100px;">
                <div>
                    <img src="/images/mat1.jpg" alt="Premium Bar Mat" style="width:100%; border-radius:16px; box-shadow: 0 15px 40px rgba(0,0,0,0.3);">
                </div>
                <div>
                    <h2>Premium Bar Counter Mats</h2>
                    <p style="font-size: 1.2rem; line-height: 1.8;">
                        Perfect for bars and restaurants. Heavy-duty rubber base with high-absorbency top surface. 
                        Fully customizable with your logo and branding.
                    </p>
                    <ul style="margin: 20px 0; padding-left: 20px;">
                        <li>Anti-slip backing</li>
                        <li>Easy to clean</li>
                        <li>Available in multiple sizes</li>
                    </ul>
                    <a href="/contact" style="background:#f97316; color:white; padding:14px 32px; border-radius:50px; text-decoration:none; font-weight:bold;">
                        Request Quote
                    </a>
                </div>
            </div>

            <!-- Product 2 -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; margin-bottom: 100px;">
                <div style="order: 2;">
                    <img src="/images/mat2.jpg" alt="Restaurant Counter Mat" style="width:100%; border-radius:16px; box-shadow: 0 15px 40px rgba(0,0,0,0.3);">
                </div>
                <div>
                    <h2>Restaurant Checkout Mats</h2>
                    <p style="font-size: 1.2rem; line-height: 1.8;">
                        Ideal for point-of-sale areas. Durable and eye-catching designs that help reinforce your brand at every transaction.
                    </p>
                    <a href="/contact" style="background:#f97316; color:white; padding:14px 32px; border-radius:50px; text-decoration:none; font-weight:bold;">
                        Request Quote
                    </a>
                </div>
            </div>

            <!-- Product 3 -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center;">
                <div>
                    <img src="/images/mat3.jpg" alt="Promotional Mat" style="width:100%; border-radius:16px; box-shadow: 0 15px 40px rgba(0,0,0,0.3);">
                </div>
                <div>
                    <h2>Promotional & Gift Mats</h2>
                    <p style="font-size: 1.2rem; line-height: 1.8;">
                        Perfect for corporate gifts, events, and promotional campaigns. High perceived value and long-lasting branding.
                    </p>
                    <a href="/contact" style="background:#f97316; color:white; padding:14px 32px; border-radius:50px; text-decoration:none; font-weight:bold;">
                        Request Quote
                    </a>
                </div>
            </div>
        </div>
    </section>
</Layout>