---
const title = "OEM Custom Counter Mats | Premium Quality for Global Brands";
---

<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style>
        body {
            font-family: system-ui, -apple-system, sans-serif;
            margin: 0;
            padding: 0;
            background: #0f172a;
            color: #e2e8f0;
            line-height: 1.6;
        }
        header {
            background: linear-gradient(135deg, #1e40af, #3b82f6);
            padding: 140px 20px;
            text-align: center;
        }
        h1 {
            font-size: 3.5rem;
            margin: 0 0 24px 0;
        }
        .subtitle {
            font-size: 1.4rem;
            max-width: 800px;
            margin: 0 auto 40px;
        }
        .btn {
            background: #f97316;
            color: white;
            padding: 18px 48px;
            font-size: 1.25rem;
            border-radius: 50px;
            text-decoration: none;
            font-weight: 600;
            display: inline-block;
        }
        .btn:hover {
            background: #ea580c;
            transform: scale(1.05);
        }
        section {
            padding: 100px 20px;
            text-align: center;
        }
        .features {
            background: #1e2937;
        }
        .feature-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 40px;
            max-width: 1200px;
            margin: 60px auto;
        }
        .feature {
            background: #334155;
            padding: 40px;
            border-radius: 16px;
        }
    </style>
</head>
<body>
    <header>
        <h1>OEM Custom Counter Mats</h1>
        <p class="subtitle">
            Premium quality custom bar mats, counter mats & promotional mats<br>
            for restaurants, bars, retail stores and global brands.
        </p>
        <a href="#contact" class="btn">Get Custom Quote Now</a>
    </header>

    <section class="features">
        <h2>Why Partner With Us?</h2>
        <div class="feature-grid">
            <div class="feature">
                <h3>Full Customization</h3>
                <p>Your logo, colors, sizes, and design — completely custom made.</p>
            </div>
            <div class="feature">
                <h3>High-Quality Materials</h3>
                <p>Durable rubber base with premium absorbent fabric surface.</p>
            </div>
            <div class="feature">
                <h3>Global Shipping</h3>
                <p>Reliable export to clients worldwide with quality control.</p>
            </div>
            <div class="feature">
                <h3>Flexible MOQ</h3>
                <p>Perfect for both small test orders and large production runs.</p>
            </div>
        </div>
    </section>

    <section id="contact">
        <h2>Ready to Start Your Custom Project?</h2>
        <p style="font-size: 1.3rem; max-width: 700px; margin: 30px auto;">
            Send us your requirements and we’ll provide a fast quote.
        </p>
        <a href="mailto:your-email@example.com" class="btn">Contact Us Now</a>
    </section>
</body>
</html>