```astro
---
import Layout from '../components/Layout.astro';
---

<Layout title="Company Profile - Custom Counter Mats">
    <!-- Hero -->
    <section class="hero">
        <div class="hero-inner">
            <div class="hero-content">
                <span class="eyebrow">GIFT IDEA LIMITED</span>

                <h1>
                    Your Trusted OEM Partner for
                    <span>Custom Counter Mats</span>
                </h1>

                <p class="hero-text">
                    We help global brands, distributors, retailers, and promotional
                    companies create high-quality custom counter mats through
                    reliable OEM manufacturing, flexible customization, and
                    professional service.
                </p>

                <div class="hero-actions">
                    <a href="/request-a-quote" class="btn btn-primary">
                        Request a Quote
                    </a>

                    <a href="/products" class="btn btn-secondary">
                        View Products
                    </a>
                </div>
            </div>

            <div class="hero-image">
                <img
                    src="/images/home/hero-counter-mat.webp"
                    alt="Custom counter mat manufactured for OEM applications"
                    loading="eager"
                />
            </div>
        </div>
    </section>


    <!-- Company Introduction -->
    <section class="section section-white">
        <div class="two-column">
            <div class="section-image">
                <img
                    src="/images/home/oem-manufacturing-process.webp"
                    alt="OEM counter mat manufacturing process"
                    loading="lazy"
                />
            </div>

            <div class="section-content">
                <span class="section-label">ABOUT OUR COMPANY</span>

                <h2>
                    Manufacturing Custom Counter Mats
                    <span>for Global Customers</span>
                </h2>

                <p>
                    GIFT IDEA LIMITED specializes in custom counter mats and
                    promotional products for international brands, distributors,
                    retailers, and businesses.
                </p>

                <p>
                    With more than 13 years of manufacturing experience, we
                    understand that successful OEM products require more than
                    production alone. Consistent quality, accurate customization,
                    clear communication, and dependable delivery are all essential
                    to a successful project.
                </p>

                <p>
                    Our goal is to make the OEM manufacturing process straightforward
                    and dependable — from the initial concept and artwork review
                    through sampling, production, quality inspection, and shipment.
                </p>
            </div>
        </div>
    </section>


    <!-- Trust Stats -->
    <section class="stats-section">
        <div class="stats-grid">
            <div class="stat">
                <strong>13+</strong>
                <span>Years Manufacturing Experience</span>
            </div>

            <div class="stat">
                <strong>OEM</strong>
                <span>Private Label Manufacturing</span>
            </div>

            <div class="stat">
                <strong>30+</strong>
                <span>Export Markets</span>
            </div>

            <div class="stat">
                <strong>Global</strong>
                <span>International Customer Support</span>
            </div>
        </div>
    </section>


    <!-- Who We Are -->
    <section class="section section-light">
        <div class="section-heading">
            <span class="section-label">WHO WE ARE</span>

            <h2>
                A Manufacturing Partner,
                <span>Not Just a Supplier</span>
            </h2>

            <p>
                We work closely with customers to turn product ideas and artwork
                into practical, production-ready custom counter mats.
            </p>
        </div>

        <div class="feature-grid">
            <article class="feature-card">
                <div class="icon">01</div>
                <h3>OEM Manufacturing</h3>
                <p>
                    Professional production support from concept and sampling
                    through manufacturing, inspection, packing, and shipment.
                </p>
            </article>

            <article class="feature-card">
                <div class="icon">02</div>
                <h3>Custom Solutions</h3>
                <p>
                    Flexible options for materials, dimensions, shapes, printing,
                    construction, packaging, and branding requirements.
                </p>
            </article>

            <article class="feature-card">
                <div class="icon">03</div>
                <h3>Global Export</h3>
                <p>
                    Experience supporting international customers with clear
                    communication and organized delivery management.
                </p>
            </article>

            <article class="feature-card">
                <div class="icon">04</div>
                <h3>Project Support</h3>
                <p>
                    We help customers move efficiently from artwork and prototypes
                    to finished production.
                </p>
            </article>

            <article class="feature-card">
                <div class="icon">05</div>
                <h3>Flexible Production</h3>
                <p>
                    Manufacturing solutions can be adapted to different product
                    specifications, quantities, and brand requirements.
                </p>
            </article>

            <article class="feature-card">
                <div class="icon">06</div>
                <h3>Professional Service</h3>
                <p>
                    Clear communication and attention to project details help keep
                    OEM orders moving smoothly.
                </p>
            </article>
        </div>
    </section>


    <!-- Manufacturing Expertise -->
    <section class="section section-white">
        <div class="section-heading">
            <span class="section-label">OUR EXPERTISE</span>

            <h2>
                From Product Concept
                <span>to Finished Production</span>
            </h2>

            <p>
                Our manufacturing approach is designed to give customers
                better control over customization, quality, and delivery.
            </p>
        </div>

        <div class="process-grid">
            <div class="process-item">
                <span>01</span>
                <h3>Artwork & Requirements</h3>
                <p>
                    Review your artwork, dimensions, materials, branding,
                    packaging, and other project specifications.
                </p>
            </div>

            <div class="process-item">
                <span>02</span>
                <h3>Prototype & Sampling</h3>
                <p>
                    Develop samples when required so product details can be
                    reviewed before mass production.
                </p>
            </div>

            <div class="process-item">
                <span>03</span>
                <h3>Production</h3>
                <p>
                    Manufacture the approved product according to the agreed
                    specifications and production requirements.
                </p>
            </div>

            <div class="process-item">
                <span>04</span>
                <h3>Quality Inspection</h3>
                <p>
                    Inspect finished products to help maintain consistent
                    quality and meet project requirements.
                </p>
            </div>

            <div class="process-item">
                <span>05</span>
                <h3>Packing</h3>
                <p>
                    Prepare finished products for safe and organized shipment
                    according to customer requirements.
                </p>
            </div>

            <div class="process-item">
                <span>06</span>
                <h3>Global Shipment</h3>
                <p>
                    Coordinate shipment preparation for international customers
                    and export orders.
                </p>
            </div>
        </div>
    </section>


    <!-- Product Range -->
    <section class="section section-light">
        <div class="section-heading">
            <span class="section-label">PRODUCT RANGE</span>

            <h2>
                Custom Counter Mat Solutions
                <span>for Different Applications</span>
            </h2>

            <p>
                Choose from established product formats or develop a custom
                solution around your brand and application.
            </p>
        </div>

        <div class="product-grid">
            <a href="/products" class="product-card">
                <h3>Hard Surface Counter Mats</h3>
                <p>
                    Durable counter display solutions designed for branded
                    promotional and retail applications.
                </p>
                <span>Explore Products →</span>
            </a>

            <a href="/products" class="product-card">
                <h3>Fabric Counter Mats</h3>
                <p>
                    Flexible fabric-based mats suitable for colorful branding
                    and promotional applications.
                </p>
                <span>Explore Products →</span>
            </a>

            <a href="/products" class="product-card">
                <h3>Changeable Insert Mats</h3>
                <p>
                    Practical designs that allow promotional graphics or
                    inserts to be changed when needed.
                </p>
                <span>Explore Products →</span>
            </a>

            <a href="/products" class="product-card">
                <h3>Premium Bar Counter Mats</h3>
                <p>
                    Branded solutions developed for bars, hospitality,
                    beverage promotions, and countertop applications.
                </p>
                <span>Explore Products →</span>
            </a>

            <a href="/products" class="product-card">
                <h3>Eco-Friendly Counter Mats</h3>
                <p>
                    Custom solutions designed around customers seeking more
                    environmentally conscious product options.
                </p>
                <span>Explore Products →</span>
            </a>

            <a href="/products" class="product-card">
                <h3>Custom Shapes & Sizes</h3>
                <p>
                    Customized dimensions and shapes for unique branding,
                    product displays, and promotional requirements.
                </p>
                <span>Explore Products →</span>
            </a>
        </div>
    </section>


    <!-- Quality -->
    <section class="section section-white">
        <div class="two-column quality-layout">
            <div class="section-content">
                <span class="section-label">QUALITY & RELIABILITY</span>

                <h2>
                    Quality Control
                    <span>at Every Stage</span>
                </h2>

                <p>
                    Quality begins with understanding the customer's requirements
                    and continues throughout the production process.
                </p>

                <div class="check-list">
                    <div>
                        <span>✓</span>
                        <p>Artwork and specification review</p>
                    </div>

                    <div>
                        <span>✓</span>
                        <p>Material and construction checks</p>
                    </div>

                    <div>
                        <span>✓</span>
                        <p>Production inspection</p>
                    </div>

                    <div>
                        <span>✓</span>
                        <p>Finished product quality review</p>
                    </div>

                    <div>
                        <span>✓</span>
                        <p>Packaging and shipment preparation</p>
                    </div>
                </div>
            </div>

            <div class="quality-box">
                <div class="quality-number">01</div>
                <h3>Reliable OEM Production</h3>
                <p>
                    Our focus is on delivering products that match the agreed
                    specifications while providing clear communication throughout
                    the project.
                </p>
            </div>
        </div>
    </section>


    <!-- Global Export -->
    <section class="global-section">
        <div class="global-content">
            <span class="section-label">GLOBAL EXPORT</span>

            <h2>
                Supporting Brands
                <span>Around the World</span>
            </h2>

            <p>
                Our products are supplied to international customers across
                30+ export markets. We understand the importance of responsive
                communication, accurate specifications, professional packing,
                and dependable shipment coordination.
            </p>

            <a href="/request-a-quote" class="global-button">
                Discuss Your Project →
            </a>
        </div>
    </section>


    <!-- Vision -->
    <section class="vision-section">
        <div class="vision-inner">
            <span class="section-label">OUR VISION</span>

            <h2>
                Building Long-Term
                <span>OEM Partnerships</span>
            </h2>

            <p>
                Our vision is to become a trusted global partner for customized
                promotional products by combining manufacturing expertise,
                practical innovation, consistent quality, and professional service.
            </p>
        </div>
    </section>


    <!-- CTA -->
    <section class="cta-section">
        <div class="cta-inner">
            <div>
                <span class="section-label">START YOUR PROJECT</span>

                <h2>
                    Ready to Create
                    <span>Your Custom Counter Mat?</span>
                </h2>

                <p>
                    Tell us about your product, quantity, size, materials,
                    artwork, and delivery requirements. Our team will help
                    you evaluate your OEM project.
                </p>
            </div>

            <div class="cta-actions">
                <a href="/request-a-quote" class="btn btn-primary">
                    Request a Quote
                </a>

                <a href="/contact" class="btn btn-outline">
                    Contact Us
                </a>
            </div>
        </div>
    </section>
</Layout>


<style>
    .hero {
        background: linear-gradient(135deg, #f8fafc 0%, #eef2ff 100%);
        padding: 110px 20px 90px;
    }

    .hero-inner {
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1.05fr 0.95fr;
        align-items: center;
        gap: 70px;
    }

    .hero-content {
        max-width: 650px;
    }

    .eyebrow,
    .section-label {
        display: inline-block;
        color: var(--primary);
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .hero h1 {
        margin: 16px 0 24px;
        color: var(--dark);
        font-size: clamp(2.5rem, 5vw, 4.2rem);
        line-height: 1.08;
        letter-spacing: -0.04em;
    }

    .hero h1 span,
    h2 span {
        color: var(--primary);
    }

    .hero-text {
        max-width: 620px;
        color: #334155;
        font-size: 1.12rem;
        line-height: 1.8;
    }

    .hero-actions,
    .cta-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
        margin-top: 32px;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 50px;
        padding: 0 26px;
        border-radius: 9px;
        font-weight: 700;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .btn-primary {
        background: var(--primary);
        color: #fff;
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        opacity: 0.92;
    }

    .btn-secondary,
    .btn-outline {
        border: 1px solid var(--border);
        background: #fff;
        color: var(--dark);
    }

    .btn-secondary:hover,
    .btn-outline:hover {
        border-color: var(--primary);
        color: var(--primary);
    }

    .hero-image {
        overflow: hidden;
        border-radius: 20px;
        background: #fff;
        box-shadow: 0 24px 60px rgba(15, 23, 42, 0.12);
    }

    .hero-image img {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 16 / 10;
        object-fit: contain;
    }

    .section {
        padding: 100px 20px;
    }

    .section-white {
        background: #fff;
    }

    .section-light {
        background: var(--light-gray);
    }

    .two-column {
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 75px;
        align-items: center;
    }

    .section-image {
        overflow: hidden;
        border-radius: 18px;
    }

    .section-image img {
        display: block;
        width: 100%;
        aspect-ratio: 4 / 3;
        object-fit: cover;
    }

    .section-content h2,
    .section-heading h2,
    .global-content h2,
    .vision-inner h2,
    .cta-inner h2 {
        margin: 14px 0 22px;
        color: var(--dark);
        font-size: clamp(2rem, 4vw, 3rem);
        line-height: 1.15;
        letter-spacing: -0.03em;
    }

    .section-content p,
    .section-heading > p,
    .global-content > p,
    .vision-inner > p,
    .cta-inner p {
        color: #475569;
        font-size: 1rem;
        line-height: 1.8;
    }

    .stats-section {
        padding: 55px 20px;
        background: var(--dark);
    }

    .stats-grid {
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
    }

    .stat {
        padding: 10px 25px;
        text-align: center;
        border-right: 1px solid rgba(255, 255, 255, 0.14);
    }

    .stat:last-child {
        border-right: 0;
    }

    .stat strong {
        display: block;
        margin-bottom: 8px;
        color: #fff;
        font-size: 2rem;
    }

    .stat span {
        color: #cbd5e1;
        font-size: 0.9rem;
        line-height: 1.5;
    }

    .section-heading {
        max-width: 760px;
        margin: 0 auto 50px;
        text-align: center;
    }

    .feature-grid,
    .product-grid {
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
    }

    .feature-card {
        padding: 32px;
        border: 1px solid var(--border);
        border-radius: 14px;
        background: #fff;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .feature-card:hover,
    .product-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 15px 35px rgba(15, 23, 42, 0.08);
    }

    .icon,
    .process-item > span {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        margin-bottom: 20px;
        border-radius: 9px;
        background: #eef2ff;
        color: var(--primary);
        font-size: 0.8rem;
        font-weight: 800;
    }

    .feature-card h3,
    .process-item h3,
    .product-card h3,
    .quality-box h3 {
        margin: 0 0 12px;
        color: var(--dark);
        font-size: 1.2rem;
    }

    .feature-card p,
    .process-item p,
    .product-card p,
    .quality-box p {
        margin: 0;
        color: #475569;
        font-size: 0.96rem;
        line-height: 1.7;
    }

    .process-grid {
        max-width: 1100px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 45px 30px;
    }

    .process-item {
        position: relative;
        padding-left: 5px;
    }

    .process-item > span {
        border-radius: 50%;
    }

    .product-card {
        display: block;
        padding: 32px;
        border: 1px solid var(--border);
        border-radius: 14px;
        background: #fff;
        text-decoration: none;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .product-card span {
        display: inline-block;
        margin-top: 22px;
        color: var(--primary);
        font-weight: 700;
        font-size: 0.92rem;
    }

    .quality-layout {
        align-items: stretch;
    }

    .check-list {
        margin-top: 28px;
        display: grid;
        gap: 13px;
    }

    .check-list div {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .check-list span {
        color: var(--primary);
        font-weight: 800;
    }

    .check-list p {
        margin: 0;
    }

    .quality-box {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 50px;
        border-radius: 18px;
        background: linear-gradient(145deg, #eef2ff, #f8fafc);
    }

    .quality-number {
        margin-bottom: 20px;
        color: var(--primary);
        font-size: 4rem;
        font-weight: 900;
        line-height: 1;
    }

    .global-section {
        min-height: 500px;
        padding: 100px 20px;
        display: flex;
        align-items: center;
        background:
            linear-gradient(rgba(15, 23, 42, 0.88), rgba(15, 23, 42, 0.88)),
            url('/images/home/global-export-markets.webp') center / cover no-repeat;
    }

    .global-content {
        width: 100%;
        max-width: 850px;
        margin: 0 auto;
        text-align: center;
    }

    .global-content h2 {
        color: #fff;
    }

    .global-content > p {
        color: #f1f5f9;
        font-size: 1.05rem;
        line-height: 1.8;
    }

    .global-button {
        display: inline-flex;
        margin-top: 28px;
        padding: 14px 28px;
        border-radius: 9px;
        background: var(--primary);
        color: #fff;
        font-weight: 700;
        text-decoration: none;
    }

    .vision-section {
        padding: 100px 20px;
        background: #fff;
    }

    .vision-inner {
        max-width: 850px;
        margin: 0 auto;
        text-align: center;
    }

    .vision-inner > p {
        font-size: 1.08rem;
    }

    .cta-section {
        padding: 75px 20px;
        background: var(--light-gray);
    }

    .cta-inner {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 50px;
        padding: 55px;
        border-radius: 20px;
        background: #fff;
        box-shadow: 0 15px 45px rgba(15, 23, 42, 0.07);
    }

    .cta-inner h2 {
        margin-bottom: 15px;
    }

    .cta-inner p {
        max-width: 700px;
        margin: 0;
    }

    .cta-actions {
        flex-shrink: 0;
        margin-top: 0;
    }

    @media (max-width: 900px) {
        .hero-inner,
        .two-column {
            grid-template-columns: 1fr;
        }

        .hero-inner {
            gap: 45px;
        }

        .hero-content {
            max-width: none;
            text-align: center;
            margin: 0 auto;
        }

        .hero-text {
            margin-left: auto;
            margin-right: auto;
        }

        .hero-actions {
            justify-content: center;
        }

        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
            row-gap: 30px;
        }

        .stat:nth-child(2) {
            border-right: 0;
        }

        .feature-grid,
        .product-grid,
        .process-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .cta-inner {
            flex-direction: column;
            text-align: center;
        }

        .cta-actions {
            justify-content: center;
        }
    }

    @media (max-width: 600px) {
        .hero {
            padding: 75px 20px 65px;
        }

        .section {
            padding: 70px 20px;
        }

        .hero h1 {
            font-size: 2.35rem;
        }

        .hero-text {
            font-size: 1rem;
        }

        .hero-actions,
        .cta-actions {
            flex-direction: column;
        }

        .btn {
            width: 100%;
        }

        .stats-grid,
        .feature-grid,
        .product-grid,
        .process-grid {
            grid-template-columns: 1fr;
        }

        .stat {
            border-right: 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.14);
            padding-bottom: 25px;
        }

        .stat:last-child {
            border-bottom: 0;
        }

        .quality-box {
            padding: 35px;
        }

        .cta-inner {
            padding: 35px 25px;
        }
    }
\n\n/* Homepage hero layout synchronization */\n</style>