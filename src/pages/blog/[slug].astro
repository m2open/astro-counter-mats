---
import Layout from '../../components/Layout.astro';
import { craftQuery } from '../../lib/craft';

export async function getStaticPaths() {
  const data = await craftQuery(`
    {
      entries(section: "blog") {
        slug
      }
    }
  `);

  return data.entries.map((entry: any) => ({
    params: { slug: entry.slug },
  }));
}

const { slug } = Astro.params;

const data = await craftQuery(`
  {
    entry(section: "blog", slug: "${slug}") {
      id
      title
      ... on blog_default_Entry {
        summary
        body
        publishedDate @formatDateTime(format: "Y-m-d")
      }
    }
  }
`);

const post = data.entry;
---

<Layout title={post.title}>
    <section style="padding: 120px 20px 60px; text-align: center; background: linear-gradient(135deg, #1e40af, #3b82f6);">
        <h1 style="font-size: 3rem; margin-bottom: 20px;">{post.title}</h1>
        <p style="color: #93c5fd;">{post.publishedDate}</p>
    </section>

    <section style="padding: 80px 20px; max-width: 800px; margin: 0 auto;">
        <p style="font-size: 1.2rem; opacity: 0.8; margin-bottom: 2rem;">{post.summary}</p>
        <div style="line-height: 1.8;">{post.body}</div>
        <a href="/blog" style="display: inline-block; margin-top: 3rem; color: #f97316; text-decoration: none; font-weight: 600;">← Back to Blog</a>
    </section>
</Layout>
