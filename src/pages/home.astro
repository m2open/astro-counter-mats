---
// CustomCounterMat Home Page v2.1
// Premium Industrial Manufacturer Design

const productLines = [
  {
    name: "Hard Surface Counter Mats",
    desc: "Durable commercial surfaces designed for long-term branding applications.",
    slug: "hard-surface-counter-mats"
  },
  {
    name: "Fabric Counter Mats",
    desc: "Soft-touch promotional mats with high-quality custom printing.",
    slug: "fabric-counter-mats"
  },
  {
    name: "Changeable Insert Counter Mats",
    desc: "Flexible solutions for seasonal campaigns and replaceable graphics.",
    slug: "changeable-insert-counter-mats"
  },
  {
    name: "Premium Bar Counter Mats",
    desc: "Heavy-duty mats developed for hospitality, bars, and beverage brands.",
    slug: "premium-bar-counter-mats"
  },
  {
    name: "Eco-friendly Counter Mats",
    desc: "Sustainable material options for responsible brand promotion.",
    slug: "eco-friendly-counter-mats"
  },
  {
    name: "Custom Shapes & Sizes",
    desc: "Fully customized dimensions and specifications for unique projects.",
    slug: "custom-shapes-sizes"
  }
];

const capabilities = [
  {
    title: "Manufacturing Expertise",
    desc: "Complete production knowledge from material selection to finished products."
  },
  {
    title: "Custom Engineering",
    desc: "Every project is developed around your specifications and market needs."
  },
  {
    title: "Quality Control",
    desc: "Consistent production standards for international business partners."
  },
  {
    title: "Export Support",
    desc: "Professional documentation and shipping coordination worldwide."
  }
];

const processSteps = [
  "Project Discussion",
  "Artwork & Specification Review",
  "Sample Approval",
  "Mass Production",
  "Global Delivery"
];

const industries = [
  "Retail Brands",
  "Hospitality",
  "Bars & Breweries",
  "Food & Beverage",
  "Promotional Agencies",
  "Corporate Branding"
];
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>
    Custom Counter Mats | OEM Manufacturer & Private Label Supplier
  </title>

  <meta
    name="description"
    content="Custom counter mat OEM manufacturing for global brands, distributors and retailers. Factory direct production with custom materials, printing and worldwide shipping."
  />
</head>

<body>

<section class="hero">

  <p class="eyebrow">
    OEM Counter Mat Manufacturer
  </p>

  <h1>
    Custom Counter Mats
    Manufactured for Global Brands
  </h1>

  <p class="hero-text">
    OEM and private label counter mat manufacturing with
    custom materials, printing, packaging and worldwide
    export support.
  </p>

  <div class="actions">

    <a href="#quote" class="btn primary">
      Request a Quote
    </a>

    <a href="/products" class="btn secondary">
      View Products
    </a>

  </div>

</section>


<section class="trust-bar">

  <div>
    OEM Manufacturing
  </div>

  <div>
    Custom Solutions
  </div>

  <div>
    Factory Direct
  </div>

  <div>
    Global Shipping
  </div>

</section>


<section class="products">

  <div class="section-header">

    <p class="eyebrow">
      Product Solutions
    </p>

    <h2>
      Custom Counter Mat Product Lines
    </h2>

    <p>
      Professional OEM solutions designed for brands,
      distributors and promotional markets worldwide.
    </p>

  </div>


  <div class="grid">

    {productLines.map((product) => (

      <article class="card">

        <h3>
          {product.name}
        </h3>

        <p>
          {product.desc}
        </p>

        <a href={`/products/${product.slug}/`}>
          Explore →
        </a>

      </article>

    ))}

  </div>

</section>
<section class="capabilities">

  <div class="section-header">

    <p class="eyebrow">
      Why Partner With Us
    </p>

    <h2>
      Built for Long-Term OEM Partnerships
    </h2>

    <p>
      We support global companies with reliable
      manufacturing, customization and export services.
    </p>

  </div>


  <div class="grid">

    {capabilities.map((item) => (

      <article class="card">

        <h3>
          {item.title}
        </h3>

        <p>
          {item.desc}
        </p>

      </article>

    ))}

  </div>

</section>



<section class="process">

  <div class="section-header">

    <p class="eyebrow">
      Manufacturing Process
    </p>

    <h2>
      From Concept to Global Delivery
    </h2>

  </div>


  <div class="steps">

    {processSteps.map((step, index) => (

      <div class="step">

        <div class="number">
          {index + 1}
        </div>

        <h3>
          {step}
        </h3>

      </div>

    ))}

  </div>

</section>



<section class="industries">

  <div class="section-header">

    <p class="eyebrow">
      Industries We Serve
    </p>

    <h2>
      Supporting Brands Across Multiple Markets
    </h2>

  </div>


  <div class="industry-grid">

    {industries.map((industry) => (

      <div class="industry">
        {industry}
      </div>

    ))}

  </div>

</section>



<section class="global">

  <div class="section-header">

    <p class="eyebrow">
      Global Export Capability
    </p>

    <h2>
      Serving International Markets
    </h2>

    <p>
      Supporting distributors, retailers and brands
      with reliable production and worldwide delivery.
    </p>

  </div>


  <div class="market-grid">

    <div>North America</div>
    <div>Europe</div>
    <div>Australia</div>
    <div>Asia</div>
    <div>Middle East</div>

  </div>

</section>



<section class="cta" id="quote">

  <h2>
    Ready to Develop Your Custom Counter Mat?
  </h2>

  <p>
    Share your requirements and our team will
    provide a production solution for your project.
  </p>


  <a href="mailto:countermat25@gmail.com" class="btn primary">
    Start Your Project
  </a>

</section>


</body>
</html>



<style>

:root {
  --primary: #4F46E5;
  --dark: #111827;
  --text: #475569;
  --light: #F8FAFC;
  --border: #E2E8F0;
}


body {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  color: var(--dark);
  background: #ffffff;
}


section {
  max-width: 1200px;
  margin: auto;
  padding: 90px 24px;
}


/* Hero - match index.astro */

.hero {
  text-align: center;
  padding: 160px 24px;
  background: linear-gradient(135deg, #1e40af, #3b82f6);
  color: white;
}


.hero .eyebrow {
  color: white;
}


h1 {
  font-size: clamp(2.8rem, 6vw, 4.5rem);
  line-height: 1.1;
  margin: 20px auto;
  max-width: 900px;
}


h2 {
  font-size: 2.4rem;
  margin-bottom: 20px;
}


h3 {
  font-size: 1.25rem;
}


.hero-text {
  max-width: 720px;
  margin: auto;
  color: rgba(255,255,255,0.9);
  font-size: 1.15rem;
  line-height: 1.7;
}


.section-header {
  max-width: 700px;
  margin-bottom: 50px;
}


.section-header p {
  color: var(--text);
  font-size: 1.15rem;
  line-height: 1.7;
}


.eyebrow {
  color: var(--primary);
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
  font-size: .85rem;
}


.actions {
  margin-top: 40px;
  display:flex;
  justify-content:center;
  gap:20px;
  flex-wrap:wrap;
}


.btn {
  padding:14px 32px;
  border-radius:8px;
  text-decoration:none;
  font-weight:700;
  transition:.25s;
}


.btn:hover {
  transform:translateY(-2px);
}


.primary {
  background:var(--primary);
  color:white;
}


.secondary {
  background:white;
  border:1px solid white;
  color:#1e40af;
}


/* Trust Bar */

.trust-bar {
  display:grid;
  grid-template-columns:repeat(4,1fr);
  background:var(--light);
  border-radius:16px;
  text-align:center;
  font-weight:700;
  padding:32px 20px;
  gap:20px;
}


/* Cards */

.grid {
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
  gap:24px;
}


.card {
  padding:32px;
  background:var(--light);
  border:1px solid var(--border);
  border-radius:16px;
  transition:.25s;
}


.card:hover {
  border-color:var(--primary);
  transform:translateY(-5px);
}


.card a {
  color:var(--primary);
  font-weight:700;
  text-decoration:none;
}


/* Process */

.steps {
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
  gap:24px;
}


.step {
  text-align:center;
}


.number {
  width:48px;
  height:48px;
  margin:auto;
  border-radius:50%;
  background:var(--primary);
  color:white;
  display:flex;
  align-items:center;
  justify-content:center;
}


/* Industry and Market */

.industry-grid,
.market-grid {
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(180px,1fr));
  gap:20px;
}


.industry,
.market-grid div {
  padding:24px;
  background:var(--light);
  border:1px solid var(--border);
  border-radius:12px;
  text-align:center;
  font-weight:600;
}


/* CTA */

.cta {
  text-align:center;
  background:var(--light);
  border-radius:24px;
}


@media(max-width:768px){

  .trust-bar {
    grid-template-columns:1fr;
  }


  h1 {
    font-size:2.5rem;
  }

}

</style>
