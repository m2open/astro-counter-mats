---
const productLines = [
  { name: "Hard Surface Counter Mats", slug: "hard-surface-counter-mats" },
  { name: "Fabric Counter Mats", slug: "fabric-counter-mats" },
  { name: "Changeable Insert Counter Mats", slug: "changeable-insert-counter-mats" },
  { name: "Premium Bar Counter Mats", slug: "premium-bar-counter-mats" },
  { name: "Eco-Friendly Counter Mats", slug: "eco-friendly-counter-mats" },
  { name: "Custom Shapes & Sizes", slug: "custom-shapes-sizes" },
  { name: "Duraframe Window Poster Frame", slug: "duraframe-window-poster-frame" },
];

const solutions = [
  "Bars & Nightclubs",
  "Restaurants & Hospitality",
  "Retail & Pop-Up Branding",
  "Eco-Conscious Venues",
  "Custom Layouts & Odd Spaces",
];

const path = Astro.url.pathname;
const currentPage =
  path === '/' ? 'home' :
  path.startsWith('/products') ? 'products' :
  path.startsWith('/solutions') ? 'solutions' :
  path.startsWith('/blog') ? 'blog' :
  path.startsWith('/contact') ? 'contact' :
  '';
---

<footer style="border-top: 1px solid #334155;">
    <div style="background: #0b1220; padding: 60px 20px 50px;">
        <p style="font-size: 1.25rem; max-width: 800px; margin: 0 auto; line-height: 1.6; text-align: center;">
            Add your designs to Custom Counter Mats of beautiful products, which we ship to you or help you to ship to your customers around the world.
        </p>
    </div>

    <div style="background: #020617; padding: 50px 20px;">
    <div style="max-width: 1200px; margin: 0 auto;">
        <!-- 4 Column Layout -->
        <div class="footer-columns">
            <!-- Countermats -->
            <div>
                <h3 class="footer-heading"><a href="/" class={currentPage === 'home' ? 'footer-heading-link active' : 'footer-heading-link'}>CounterMats</a></h3>
                <p class="footer-line">Company Profile</p>
                <p class="footer-line" style="margin-top: 24px;">Add: Western Industrial Building, SZ. 518101. PRC</p>
                <p class="footer-subheading">FOLLOW US</p>
                <div style="display: flex; gap: 12px; justify-content: flex-start;">
