                    </a>
                </div>
            </div>

            <!-- Products -->
            <div>
                <h3 class="footer-heading"><a href="/products" class={currentPage === 'products' ? 'footer-heading-link active' : 'footer-heading-link'}>Products</a></h3>
                {productLines.map((item) => (
                    <a href={`/products/${item.slug}`} class="footer-link">{item.name}</a>
