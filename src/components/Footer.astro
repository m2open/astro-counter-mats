                </div>
            </div>
        </div>
    </div>
    </div>

    <div style="background: #05070d; padding: 22px 20px;">
        <p style="opacity: 0.6; font-size: 0.95rem; text-align: center; margin: 0;">
            © 2026 CustomCounterMat. All Rights Reserved.
        </p>
    </div>
</footer>

<style>
    .footer-columns {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 2.5rem;
        text-align: center;
    }
    .footer-heading {
        font-size: 1.6rem;
        font-weight: 700;
        margin-bottom: 1.5rem;
        color: white;
    }
    .footer-heading-link {
        color: white;
        text-decoration: none;
    }
    .footer-heading-link:hover {
        color: #f97316;
    }
    .footer-heading-link.active {
        color: #f97316;
    }
    .footer-subheading {
        font-size: 1rem;
        letter-spacing: 0.05em;
        margin: 24px 0 12px;
        color: #cbd5e1;
    }
    .footer-line {
        margin: 0 0 10px;
        color: #e2e8f0;
        line-height: 1.5;
    }
    .footer-link {
        display: block;
        color: #e2e8f0;
        text-decoration: none;
        margin-bottom: 12px;
        line-height: 1.4;
    }
    .footer-link:hover {
        color: #f97316;
    }
    .social-icon {
        color: white;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.15s, filter 0.15s;
    }
    .social-icon:hover {
        transform: translateY(-2px);
        filter: brightness(1.1);
    }

    .footer-columns > div:nth-child(1),
    .footer-columns > div:nth-child(2),
    .footer-columns > div:nth-child(3),
    .footer-columns > div:nth-child(4) {
        text-align: left;
    }

    @media (max-width: 900px) {
        .footer-columns {
            grid-template-columns: repeat(2, 1fr);
        }
    }
    @media (max-width: 600px) {
        .footer-columns {
            grid-template-columns: 1fr;
        }
        .footer-columns > div {
            margin-bottom: 30px;
        }
    }
</style>