---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
  intro: string;
}

const { title, description, heading, intro } = Astro.props;
---

<Layout title={title} description={description}>
  <section class="legal-hero">
    <div class="legal-hero-inner">
      <span class="eyebrow">Gift Idea Limited</span>
      <h1>{heading}</h1>
      <p>{intro}</p>
    </div>
  </section>

  <section class="legal-body">
    <article class="legal-article">
      <slot />
    </article>
  </section>
</Layout>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  .legal-hero {
    padding: 140px 20px 80px;
    background: linear-gradient(135deg, #4F46E5 0%, #2563EB 100%);
    color: #ffffff;
  }

  .legal-hero-inner {
    width: min(860px, 100%);
    margin: 0 auto;
    text-align: center;
  }

  .eyebrow {
    display: inline-block;
    margin-bottom: 18px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.9;
  }

  .legal-hero h1 {
    margin: 0 0 20px;
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    line-height: 1.12;
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .legal-hero p {
    margin: 0 0 16px;
    font-size: clamp(1.02rem, 2vw, 1.18rem);
    line-height: 1.7;
    opacity: 0.95;
  }

  .legal-body {
    padding: 70px 20px 100px;
    background: #F8FAFC;
  }

  .legal-article {
    width: min(860px, 100%);
    margin: 0 auto;
    padding: 42px 46px;
    color: #334155;
    font-size: 1.02rem;
    line-height: 1.8;
    background: #ffffff;
    border: 1px solid #E2E8F0;
    border-radius: 20px;
    box-shadow: 0 15px 45px rgba(15, 23, 42, 0.08);
  }

  .legal-article :global(.toc) {
    margin: 0 0 42px;
    padding: 24px 26px;
    border: 1px solid #E2E8F0;
    border-radius: 14px;
    background: #F8FAFC;
  }

  .legal-article :global(.toc h2) {
    margin: 0 0 12px;
    color: #0f172a;
    font-size: 1.05rem;
  }

  .legal-article :global(.toc ol) {
    margin: 0;
    padding-left: 1.2rem;
  }

  .legal-article :global(.toc li) {
    margin: 0.35rem 0;
  }

  .legal-article :global(.toc a) {
    color: #1e40af;
    text-decoration: none;
    font-weight: 600;
  }

  .legal-article :global(.toc a:hover) {
    text-decoration: underline;
  }

  .legal-article :global(h2) {
    margin: 2.4rem 0 0.85rem;
    color: #0f172a;
    font-size: clamp(1.35rem, 2.4vw, 1.7rem);
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .legal-article :global(h3) {
    margin: 1.5rem 0 0.6rem;
    color: #1e293b;
    font-size: 1.12rem;
  }

  .legal-article :global(p),
  .legal-article :global(ul),
  .legal-article :global(ol) {
    margin: 0 0 1rem;
  }

  .legal-article :global(ul),
  .legal-article :global(ol) {
    padding-left: 1.25rem;
  }

  .legal-article :global(li) {
    margin: 0.35rem 0;
  }

  .legal-article :global(a) {
    color: #1e40af;
    font-weight: 600;
    text-decoration: none;
  }

  .legal-article :global(a:hover) {
    text-decoration: underline;
  }

  .legal-article :global(.meta) {
    margin-bottom: 1.5rem;
    color: #64748B;
    font-size: 0.95rem;
  }

  .legal-article :global(code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.88em;
    padding: 0.12em 0.4em;
    border-radius: 4px;
    background: #F1F5F9;
    color: #0f172a;
  }

  @media (max-width: 600px) {
    .legal-hero {
      padding: 110px 20px 60px;
    }

    .legal-body {
      padding: 48px 20px 80px;
    }

    .legal-article {
      padding: 24px 18px;
    }

    .legal-article :global(.toc) {
      padding: 18px 16px;
    }
  }
</style>
