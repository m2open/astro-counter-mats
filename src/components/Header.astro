---
const path = Astro.url.pathname;

const currentPage =
  path === '/' ? 'home' :
  path.startsWith('/products') ? 'products' :
  path.startsWith('/solutions') ? 'solutions' :
  path.startsWith('/company-profile') ? 'company-profile' :
  path.startsWith('/faq') ? 'faq' :
  path.startsWith('/blog') ? 'blog' :
  path.startsWith('/request-a-quote') ? 'request-a-quote' :
  path.startsWith('/contact') ? 'contact' :
  '';

const productLines = [
  {
    name: "Hard Surface Counter Mats",
    slug: "hard-surface-counter-mats"
  },
  {
    name: "Fabric Counter Mats",
    slug: "fabric-counter-mats"
  },
  {
    name: "Changeable Insert Counter Mats",
    slug: "changeable-insert-counter-mats"
  },
  {
    name: "Premium Bar Counter Mats",
    slug: "premium-bar-counter-mats"
  },
  {
    name: "Eco-Friendly Counter Mats",
    slug: "eco-friendly-counter-mats"
  },
  {
    name: "Custom Shapes & Sizes",
    slug: "custom-shapes-sizes"
  },
  {
    name: "Duraframe Window Poster Frame",
    slug: "duraframe-window-poster-frame"
  }
];
---

<header class="site-header">
  <nav class="nav-container">

    <a href="/" class="logo">
      CounterMats
    </a>

    <div class="desktop-menu">

      <a href="/" class={currentPage === 'home' ? 'active' : ''}>
        Home
      </a>


      <div class="products-dropdown">

        <a href="/products/" class={currentPage === 'products' ? 'active products-button' : 'products-button'}>
          Products ▾
        </a>

        <div class="products-submenu">
          {productLines.map((item) => (
            <a href={`/products/${item.slug}/`}>
              {item.name}
            </a>
          ))}
        </div>

      </div>


      <a href="/solutions" class={currentPage === 'solutions' ? 'active' : ''}>
        Solutions
      </a>


      <a href="/faq" class={currentPage === 'faq' ? 'active' : ''}>
        FAQ
      </a>


      <a href="/blog" class={currentPage === 'blog' ? 'active' : ''}>
        Blog
      </a>


      <a href="/contact" class={currentPage === 'contact' ? 'active' : ''}>
        Contact
      </a>


      <a href="/request-a-quote/" class={currentPage === 'request-a-quote' ? 'active' : ''}>
        Request a Quote
      </a>


      <a href="mailto:info@customcountermat.com" class="social email">
        ✉
      </a>


      <a href="https://wa.me/8613168787818" target="_blank" class="social whatsapp">
        ☎
      </a>


      <a href="https://x.com/countermat_2035" target="_blank" class="social x">
        X
      </a>

    </div>


    <button id="menuButton" class="mobile-button">
      ☰
    </button>

  </nav>


  <div id="mobileMenu" class="mobile-menu">

    <a href="/" class={currentPage === 'home' ? 'active' : ''}>
      Home
    </a>

    <a href="/products/">
      Products
    </a>

    <a href="/solutions">
      Solutions
    </a>

    <a href="/faq">
      FAQ
    </a>

    <a href="/blog">
      Blog
    </a>

    <a href="/contact">
      Contact
    </a>

    <a href="/request-a-quote/" class={currentPage === 'request-a-quote' ? 'active' : ''}>
      Request a Quote
    </a>

  </div>

</header>


<script>
const button = document.getElementById('menuButton');
const menu = document.getElementById('mobileMenu');

button?.addEventListener('click', () => {

  if (menu.style.display === 'flex') {
    menu.style.display = 'none';
  } else {
    menu.style.display = 'flex';
  }

});
</script>


<style>

.site-header {
  background: #1e2937;
  border-bottom: 1px solid #334155;
  position: sticky;
  top: 0;
  z-index: 100;
}


.nav-container {
  max-width: 1200px;
  margin: auto;
  padding: 1rem 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}


.logo {
  color: white;
  font-size: 1.7rem;
  font-weight: bold;
  text-decoration: none;
}


.desktop-menu {
  display: flex;
  align-items: center;
  gap: 1.8rem;
}


.desktop-menu a,
.products-button {
  color: white;
  text-decoration: none;
  font-size: 1.05rem;
}


.active {
  color: #f97316 !important;
  font-weight: 600;
}


.products-dropdown {
  position: relative;
}


.products-button {
  background: none;
  border: none;
  cursor: pointer;
}


.products-submenu {
  display: none;
  position: absolute;
  top: calc(100% - 1px);
  left: 0;
  background: #1e2937;
  border: 1px solid #334155;
  min-width: 260px;
  border-radius: 8px;
}


.products-submenu a {
  display: block;
  padding: 12px 16px;
}


.products-submenu a:hover {
  background: #334155;
}


.products-dropdown:hover .products-submenu {
  display: block;
}


.social {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}


.email {
  background: #2563eb;
}


.whatsapp {
  background: #16a34a;
}


.x {
  background: black;
}


.mobile-button {
  display: none;
  background: none;
  border: none;
  color: white;
  font-size: 1.8rem;
}


.mobile-menu {
  display: none;
  flex-direction: column;
  gap: 1.2rem;
  padding: 20px;
  text-align: center;
}


.mobile-menu a {
  color: white;
  text-decoration: none;
  font-size: 1.2rem;
}


@media(max-width:768px){

  .desktop-menu {
    display:none;
  }

  .mobile-button {
    display:block;
  }

}

</style>