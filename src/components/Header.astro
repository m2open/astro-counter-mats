    </div>

    <button id="hamburger" style="background: none; border: none; font-size: 1.8rem; color: white; cursor: pointer; padding: 5px; display: none;">☰</button>
  </nav>

  <div id="mobileMenu" style="display: none; background: #1e2937; padding: 20px; border-top: 1px solid #334155;">
    <div style="display: flex; flex-direction: column; gap: 1.5rem; font-size: 1.25rem; text-align: center;">
      <a href="/products" style={currentPage === 'products' ? 'color: #f97316; font-weight: 600;' : 'color: white; text-decoration: none;'}>Products</a>
      <a href="/blog" style={currentPage === 'blog' ? 'color: #f97316; font-weight: 600;' : 'color: white; text-decoration: none;'}>Blog</a>
      <a href="/contact" style={currentPage === 'contact' ? 'color: #f97316; font-weight: 600;' : 'color: white; text-decoration: none;'}>Contact</a>
      <div style="display: flex; gap: 16px; justify-content: center;">
        <a href="mailto:countermat25@gmail.com" title="Email" style="background: #1d4ed8; color: white; width: 44px; height: 44px; border-radius: 50%; text-decoration: none; display: flex; align-items: center; justify-content: center;">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
        </a>
