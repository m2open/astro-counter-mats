---
const path = Astro.url.pathname;

const currentPage =
  path === '/' ? 'home' :
  path.startsWith('/products') ? 'products' :
  path.startsWith('/solutions') ? 'solutions' :
  path.startsWith('/company-profile') ? 'company-profile' :
  path.startsWith('/faq') ? 'faq' :
  path.startsWith('/blog') ? 'blog' :
  path.startsWith('/request-a-quote') ? 'request-a-quote' :
  path.startsWith('/contact') ? 'contact' :
  '';

const productLines = [
  {
    name: "Hard Surface Counter Mats",
    slug: "hard-surface-counter-mats"
  },
  {
    name: "Fabric Counter Mats",
    slug: "fabric-counter-mats"
  },
  {
    name: "Changeable Insert Counter Mats",
    slug: "changeable-insert-counter-mats"
  },
  {
    name: "Premium Bar Counter Mats",
    slug: "premium-bar-counter-mats"
  },
  {
    name: "Eco-Friendly Counter Mats",
    slug: "eco-friendly-counter-mats"
  },
  {
    name: "Custom Shapes & Sizes",
    slug: "custom-shapes-sizes"
  },
  // Hidden from listings (Hide from listing = on in Craft). Uncomment to show again.
  // {
  //   name: "Duraframe Window Poster Frame",
  //   slug: "duraframe-window-poster-frame"
  // }
];
---

<header class="site-header">
  <nav class="nav-container">

    <a href="/" class="logo">
      CounterMats
    </a>

    <div class="desktop-menu">

      <a href="/" class={currentPage === 'home' ? 'active' : ''}>
        Home
      </a>


      <div class="products-dropdown">

        <a href="/products/" class={currentPage === 'products' ? 'active products-button' : 'products-button'}>
          Products ▾
        </a>

        <div class="products-submenu">
          {productLines.map((item) => (
            <a href={`/products/${item.slug}/`}>
              {item.name}
            </a>
          ))}
        </div>

      </div>


      <a href="/solutions" class={currentPage === 'solutions' ? 'active' : ''}>
        Solutions
      </a>


      <a href="/faq" class={currentPage === 'faq' ? 'active' : ''}>
        FAQ
      </a>


      <a href="/blog" class={currentPage === 'blog' ? 'active' : ''}>
        Blog
      </a>


      <a href="/contact" class={currentPage === 'contact' ? 'active' : ''}>
        Contact
      </a>


      <a href="/request-a-quote/" class={currentPage === 'request-a-quote' ? 'active' : ''}>
        Request a Quote
      </a>


      <a href="mailto:info@customcountermat.com" class="social email" title="Email us" aria-label="Email us">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
      </a>


      <a href="https://wa.me/8613168787818" target="_blank" rel="noopener" class="social whatsapp" title="WhatsApp" aria-label="WhatsApp">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
      </a>


      <a href="https://x.com/countermat_2035" target="_blank" rel="noopener" class="social x" title="Chat on X" aria-label="Chat on X">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </a>


      <a href="https://t.me/CustomCounterMat" target="_blank" rel="noopener" class="social telegram" title="Chat on Telegram" aria-label="Chat on Telegram">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M9.78 18.65 10.06 14.4l7.74-6.98c.34-.3-.07-.45-.52-.18L7.72 13.27 3.6 11.96c-.89-.28-.9-.89.2-1.33l16.04-6.18c.74-.27 1.39.18 1.12 1.42l-2.73 12.87c-.19.91-.74 1.13-1.5.71l-4.16-3.07-2 1.93c-.23.22-.41.4-.79.34Z"/></svg>
      </a>

    </div>


    <button id="menuButton" class="mobile-button">
      ☰
    </button>

  </nav>


  <div id="mobileMenu" class="mobile-menu">

    <a href="/" class={currentPage === 'home' ? 'active' : ''}>
      Home
    </a>

    <a href="/products/">
      Products
    </a>

    <a href="/solutions">
      Solutions
    </a>

    <a href="/faq">
      FAQ
    </a>

    <a href="/blog">
      Blog
    </a>

    <a href="/contact">
      Contact
    </a>

    <a href="/request-a-quote/" class={currentPage === 'request-a-quote' ? 'active' : ''}>
      Request a Quote
    </a>

  </div>

</header>


<script>
const button = document.getElementById('menuButton');
const menu = document.getElementById('mobileMenu');

button?.addEventListener('click', () => {

  if (menu.style.display === 'flex') {
    menu.style.display = 'none';
  } else {
    menu.style.display = 'flex';
  }

});
</script>


<style>

.site-header {
  background: #1e2937;
  border-bottom: 1px solid #334155;
  position: sticky;
  top: 0;
  z-index: 100;
}


.nav-container {
  max-width: 1200px;
  margin: auto;
  padding: 1rem 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}


.logo {
  color: white;
  font-size: 1.7rem;
  font-weight: bold;
  text-decoration: none;
}


.desktop-menu {
  display: flex;
  align-items: center;
  gap: 1.8rem;
}


.desktop-menu a,
.products-button {
  color: white;
  text-decoration: none;
  font-size: 1.05rem;
}


.active {
  color: #f97316 !important;
  font-weight: 600;
}


.products-dropdown {
  position: relative;
}


.products-button {
  background: none;
  border: none;
  cursor: pointer;
}


.products-submenu {
  display: none;
  position: absolute;
  top: calc(100% - 1px);
  left: 0;
  background: #1e2937;
  border: 1px solid #334155;
  min-width: 260px;
  border-radius: 8px;
}


.products-submenu a {
  display: block;
  padding: 12px 16px;
}


.products-submenu a:hover {
  background: #334155;
}


.products-dropdown:hover .products-submenu {
  display: block;
}


.social {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}


.email {
  background: #2563eb;
}


.whatsapp {
  background: #16a34a;
}


.x {
  background: black;
}


.telegram {
  background: #229ED9;
}


.mobile-button {
  display: none;
  background: none;
  border: none;
  color: white;
  font-size: 1.8rem;
}


.mobile-menu {
  display: none;
  flex-direction: column;
  gap: 1.2rem;
  padding: 20px;
  text-align: center;
}


.mobile-menu a {
  color: white;
  text-decoration: none;
  font-size: 1.2rem;
}


@media(max-width:768px){

  .desktop-menu {
    display:none;
  }

  .mobile-button {
    display:block;
  }

}

</style>