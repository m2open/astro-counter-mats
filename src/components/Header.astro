---
const { currentPage = 'home' } = Astro.props;
---

<header style="background: #1e2937; padding: 1rem 0; border-bottom: 1px solid #334155; position: sticky; top: 0; z-index: 100;">
  <nav style="max-width: 1200px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; padding: 0 20px;">
    <!-- Logo -->
    <a href="/" style="font-size: 1.7rem; font-weight: bold; text-decoration: none; color: white;">
      CounterMats
    </a>

    <!-- Desktop Menu -->
    <div class="desktop-menu" style="display: flex; gap: 2rem; font-size: 1.1rem; align-items: center;">
      <a href="/products" style={currentPage === 'products' ? 'color: #f97316; font-weight: 600;' : 'color: white; text-decoration: none;'}>Products</a>
      <a href="/blog" style={currentPage === 'blog' ? 'color: #f97316; font-weight: 600;' : 'color: white; text-decoration: none;'}>Blog</a>
      <a href="/contact" style={currentPage === 'contact' ? 'color: #f97316; font-weight: 600;' : 'color: white; text-decoration: none;'}>Contact</a>
      
      <!-- Clean Chat on X Button -->
      <a href="https://x.com/countermat_2035" target="_blank" 
         style="background: #000; color: white; padding: 10px 22px; border-radius: 9999px; text-decoration: none; display: flex; align-items: center; gap: 8px; font-weight: 500;">
        🗨 Chat on X
      </a>
    </div>

    <!-- Mobile Hamburger -->
    <button id="hamburger" style="background: none; border: none; font-size: 1.8rem; color: white; cursor: pointer; padding: 5px; display: none;">
      ☰
    </button>
  </nav>

  <!-- Mobile Menu -->
  <div id="mobileMenu" style="display: none; background: #1e2937; padding: 20px; border-top: 1px solid #334155;">
    <div style="display: flex; flex-direction: column; gap: 1.5rem; font-size: 1.25rem; text-align: center;">
      <a href="/products" style={currentPage === 'products' ? 'color: #f97316; font-weight: 600;' : 'color: white; text-decoration: none;'}>Products</a>
      <a href="/blog" style={currentPage === 'blog' ? 'color: #f97316; font-weight: 600;' : 'color: white; text-decoration: none;'}>Blog</a>
      <a href="/contact" style={currentPage === 'contact' ? 'color: #f97316; font-weight: 600;' : 'color: white; text-decoration: none;'}>Contact</a>
      <a href="https://x.com/countermat_2035" target="_blank" style="color: #60a5fa; text-decoration: none;">🗨 Chat on X</a>
    </div>
  </div>
</header>

<script>
  const hamburger = document.getElementById('hamburger');
  const mobileMenu = document.getElementById('mobileMenu');

  hamburger.addEventListener('click', () => {
    if (mobileMenu.style.display === 'none' || mobileMenu.style.display === '') {
      mobileMenu.style.display = 'block';
      hamburger.textContent = '✕';
    } else {
      mobileMenu.style.display = 'none';
      hamburger.textContent = '☰';
    }
  });
</script>

<style>
  @media (max-width: 768px) {
    .desktop-menu { display: none !important; }
    #hamburger { display: block !important; }
  }
</style>