---
const path = Astro.url.pathname;
const currentPage =
  path === '/' ? 'home' :
  path.startsWith('/products') ? 'products' :
  path.startsWith('/solutions') ? 'solutions' :
  path.startsWith('/blog') ? 'blog' :
  path.startsWith('/faq') ? 'faq' :
  path.startsWith('/contact') ? 'contact' :
  '';

const productLines = [
  { name: "Hard Surface Counter Mats", slug: "hard-surface-counter-mats" },
  { name: "Fabric Counter Mats", slug: "fabric-counter-mats" },
  { name: "Changeable Insert Counter Mats", slug: "changeable-insert-counter-mats" },
  { name: "Premium Bar Counter Mats", slug: "premium-bar-counter-mats" },
  { name: "Eco-Friendly Counter Mats", slug: "eco-friendly-counter-mats" },
  { name: "Custom Shapes & Sizes", slug: "custom-shapes-sizes" },
  { name: "Duraframe Window Poster Frame", slug: "duraframe-window-poster-frame" },
];
---

<header style="background: #1e2937; padding: 1rem 0; border-bottom: 1px solid #334155; position: sticky; top: 0; z-index: 100;">
  <nav style="max-width: 1200px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; padding: 0 20px;">
    <a href="/" style="font-size: 1.7rem; font-weight: bold; text-decoration: none; color: white;">
      CounterMats
    </a>

    <div class="desktop-menu" style="display: flex; gap: 2rem; font-size: 1.1rem; align-items: center;">
      <a href="/" style={currentPage === 'home' ? 'color: #f97316; font-weight: 600; text-decoration: none;' : 'color: white; text-decoration: none;'}>Home</a>

      <div class="products-dropdown" style="position: relative;">
        <button
          class="products-trigger"
          aria-expanded="false"
          aria-controls="products-submenu"
          style={`background: none; border: none; cursor: pointer; font: inherit; display: flex; align-items: center; gap: 4px; padding: 0; ${currentPage === 'products' ? 'color: #f97316; font-weight: 600;' : 'color: white;'}`}
        >
          Products
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <div id="products-submenu" class="products-submenu" style="display: none; position: absolute; top: calc(100% + 1rem); left: 0; background: #1e2937; border: 1px solid #334155; border-radius: 8px; min-width: 260px; padding: 0.5rem 0; box-shadow: 0 8px 24px rgba(0,0,0,0.35);">
         {productLines.map((item) => (
            <a href={`/products/${item.slug}`} style="display: block; padding: 0.6rem 1.2rem; color: white; text-decoration: none; font-size: 1rem; white-space: nowrap;" onmouseover="this.style.color='#f97316'" onmouseout="this.style.color='white'">{item.name}</a>
          ))}
        </div>
      </div>

      <a href="/solutions" style={currentPage === 'solutions' ? 'color: #f97316; font-weight: 600; text-decoration: none;' : 'color: white; text-decoration: none;'}>Solutions</a>
      <a href="/blog" style={currentPage === 'blog' ? 'color: #f97316; font-weight: 600; text-decoration: none;' : 'color: white; text-decoration: none;'}>Blog</a>
       <a href="/faq" style={currentPage === 'faq' ? 'color: #f97316; font-weight: 600; text-decoration: none;' : 'color: white; text-decoration: none;'}>FAQ</a>
      <a href="/contact" style={currentPage === 'contact' ? 'color: #f97316; font-weight: 600; text-decoration: none;' : 'color: white; text-decoration: none;'}>Contact</a>

      <div style="display: flex; gap: 10px; align-items: center;">
        <a href="mailto:countermat25@gmail.com" title="Email us" style="background: #1d4ed8; color: white; width: 40px; height: 40px; border-radius: 50%; text-decoration: none; display: flex; align-items: center; justify-content: center;">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
        </a>
        <a href="https://wa.me/8613168787818" target="_blank" title="WhatsApp" style="background: #16a34a; color: white; width: 40px; height: 40px; border-radius: 50%; text-decoration: none; display: flex; align-items: center; justify-content: center;">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
