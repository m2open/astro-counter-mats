---
import Header from './Header.astro';
import Footer from './Footer.astro';
const { title = 'OEM Custom Counter Mats' } = Astro.props;
---

<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style>
        :root {
            --primary: #1e40af;
            --accent: #f97316;
            --dark: #0f172a;
            --gray: #1e2937;
            --light-gray: #334155;
        }
        
        body {
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            margin: 0;
            background: var(--dark);
            color: #e2e8f0;
            line-height: 1.7;
        }
        
        h1, h2, h3 {
            font-weight: 700;
            line-height: 1.2;
        }
        
        a {
            text-decoration: none;
        }
        
        main {
            min-height: 100vh;
        }
        
        section {
            padding: 100px 20px;
        }
    </style>
</head>
<body>
    <Header />
    <main>
        <slot />
    </main>
    <Footer />
</body>
</html>