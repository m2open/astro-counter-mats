---
import Header from './Header.astro';
import Footer from './Footer.astro';

interface Props {
  title?: string;
  description: string;
}

const { title = 'OEM Custom Counter Mats', description } = Astro.props;

const site = Astro.site?.origin ?? 'https://customcountermat.com';
const pathname = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonical = `${site}${pathname}`;
const ogImage = `${site}/images/home/hero-counter-mat.webp`;
---

<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Website favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />
    <slot name="head" />

    <style>
        :root {
            --primary: #1e40af;
            --accent: #f97316;
            --dark: #0f172a;
            --gray: #1e2937;
            --light-gray: #334155;
        }
        
        body {
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            margin: 0;
            background: var(--dark);
            color: #e2e8f0;
            line-height: 1.7;
        }
        
        h1, h2, h3 {
            font-weight: 700;
            line-height: 1.2;
        }
        
        a {
            text-decoration: none;
        }
        
        main {
            min-height: 100vh;
        }
        
        section {
            padding: 100px 20px;
        }
    </style>
</head>
<body>
    <Header />
    <main>
        <slot />
    </main>
    <Footer />
</body>
</html>
