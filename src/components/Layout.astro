---
import Header from './Header.astro';
import Footer from './Footer.astro';

interface Props {
  title?: string;
  description: string;
  noindex?: boolean;
  ogImage?: string;
}

const { title = 'OEM Custom Counter Mats', description, noindex = false, ogImage: ogImageProp } = Astro.props;

const site = Astro.site?.origin ?? 'https://customcountermat.com';
const pathname = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonical = `${site}${pathname}`;
// Page-specific share image (e.g. first product photo); falls back to the homepage hero.
const ogImage = ogImageProp
  ? new URL(ogImageProp, site).href
  : `${site}/images/home/hero-counter-mat.webp`;

// Organization details for search engines: links the site to its official social accounts.
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Custom Counter Mat',
  url: `${site}/`,
  logo: `${site}/images/logo-countermat.svg`,
  email: 'info@customcountermat.com',
  telephone: '+86-131-6878-7818',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '5/F, Western Industrial Park',
    addressLocality: "Bao'an, Shenzhen",
    postalCode: '518101',
    addressCountry: 'CN',
  },
  sameAs: [
    'https://www.facebook.com/customcountermat',
    'https://www.instagram.com/customcountermat',
    'https://www.linkedin.com/in/customcountermat',
    'https://www.youtube.com/@Custom-CounterMat',
    'https://x.com/cc_countermat',
    'https://t.me/CustomCounterMat',
  ],
};
---

<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Custom Counter Mat" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@cc_countermat" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Website favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />
    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
    <slot name="head" />

    <style>
        :root {
            --primary: #1e40af;
            --accent: #f97316;
            --dark: #0f172a;
            --gray: #1e2937;
            --light-gray: #334155;
        }
        
        body {
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            margin: 0;
            background: var(--dark);
            color: #e2e8f0;
            line-height: 1.7;
        }
        
        h1, h2, h3 {
            font-weight: 700;
            line-height: 1.2;
        }
        
        a {
            text-decoration: none;
        }
        
        main {
            min-height: 100vh;
        }
        
        section {
            padding: 100px 20px;
        }
    </style>
</head>
<body>
    <Header />
    <main>
        <slot />
    </main>
    <Footer />
</body>
</html>
